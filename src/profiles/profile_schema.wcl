// Schema for guest OS profile files (PRD §5.3). Profiles are data, not
// code: shipped as WCL and user-extensible from `~/.config/vmlab/profiles/`.

@document
type ProfileDoc {
  @children("profile") profiles: list<Profile>
}

@block("profile")
type Profile {
  @inline(0) name: utf8
  description: utf8?
  machine: utf8?        // "q35" | "pc" (i440fx)
  firmware: utf8?       // "ovmf" | "seabios"
  secure_boot: bool?
  tpm: bool?            // swtpm 2.0 when true
  disk_bus: utf8?       // "virtio" | "ide" | "sata"
  nic_model: utf8?      // "virtio-net-pci" | "e1000" | "rtl8139"
  display: utf8?        // "qxl" | "virtio-gpu" | "std"
  cpus: i64?
  memory: std.ByteSize?  // 4GiB
  // The guest agent's channel device (§7.4): "virtio-serial" (default, the
  // vmlab.agent.0 port) | "isa-serial" (COM1, for guests with no virtio
  // drivers — the legacy agent) | "none" (no agent possible; screen-driven).
  agent_transport: utf8?
  agent_channel: bool?  // superseded by agent_transport: true = virtio-serial, false = none
  input_transport: utf8?  // "qmp" (default) | "vnc" — scripted input path (§10.3)
  virtiofs: bool?       // guest mounts virtiofs natively (default false) — §7.5 share transport
  // Dev-machine defaults (§19.1). Guest-OS-shaped, which is why they are
  // profile-sourced: a workspace path is `C:\src` on Windows and `/src` on
  // Linux. A profile setting none of them still hosts a dev machine — a
  // missing key means the vmlab floor applies (src/dev.rs).
  workspace_guest: utf8?  // guest path an `@dev` workspace lands at
}
