// Host-level daemon configuration (`~/.config/vmlab/config.wcl`).
//
// Per-field `@doc("…")` decorators feed the generated schema reference.

@document
type HostDoc {
  @child("host") host: HostConfig?
  @children("gpu") gpus: list<HostGpu>
}

@block("host")
type HostConfig {
  @doc("Segment auto-allocation pool (CIDR); default `10.213.0.0/16`")
  subnet_pool: utf8?
  @doc("Suffix for auto-registered VM names; default `vmlab.internal`")
  dns_suffix: utf8?
  @doc("Upstream resolver `ip[:port]`; default: the host resolver")
  dns_upstream: utf8?
  @doc("`host.disk_low` watchdog threshold percent (0–100); default 10")
  disk_low_percent: i64?
  @doc("Pre-shared key for cross-host segment links")
  psk: utf8?
  @doc("TCP listen port for inbound cross-host segment trunks; default 13947")
  trunk_port: i64?
  @doc("VNC viewer command; `{}` is replaced by the target")
  viewer: utf8?
  @doc("Host waypipe client for shared apps (§20.4); default: `waypipe` on PATH")
  waypipe: utf8?
  @doc("FreeRDP 3 client for shared apps from Windows guests (§20.4); default: `xfreerdp3`, then `xfreerdp`, on PATH")
  freerdp: utf8?
  @doc("ffmpeg for console recordings (§11.1); default: `ffmpeg` on PATH")
  ffmpeg: utf8?
  @doc("Network fast path: `auto` (probe; default), `off`, `sockmap`, or `afxdp`")
  fastpath: utf8?
  @doc("OCI layer chunk size for template push; default `512MiB`")
  oci_chunk_size: std.ByteSize?
  @doc("Directory holding config-weave guest binaries; default `~/.local/share/config-weave/bin`")
  config_weave_bin_dir: utf8?
  @doc("Workspace syncer per-file size guard; a larger file is refused by name; default `256MiB`")
  workspace_max_file: std.ByteSize?
  @doc("UEFI firmware override, laid out `<dir>/<arch>/` like the bundled set; default: vmlab's bundled firmware, then the host's")
  firmware_dir: utf8?
  @doc("The vmlab-hv binary machines on `hypervisor = \"vmlab\"` run (PRD §22); default: `vmlab-hv` on PATH")
  vmlab_hv: utf8?
  @doc("The hypervisor a machine runs on when it names none, by machine kind (PRD §22)")
  @child("hypervisor") hypervisor: HostHypervisor?
}

// The default hypervisor per machine kind (PRD §22): keyed by kind because
// vmlab-hv takes machines over a phase at a time.
@block("hypervisor")
type HostHypervisor {
  @doc("Default for `container` blocks: `qemu` (default) | `vmlab`")
  container: utf8?
  @doc("Default for `vm` blocks: `qemu` (default) | `vmlab` (refused on a VM until vmlab-hv's phase 2)")
  vm: utf8?
}

// A host GPU (§5.2): a GPU on this host, named so a lab file can ask for it
// with `host_gpu` without carrying a PCI address from one machine to another.
@block("gpu")
type HostGpu {
  @doc("The host GPU's name, matched case-insensitively against a lab's `host_gpu`; the inline label")
  @inline(0) name: utf8
  @doc("Host PCI address, e.g. `0000:72:00.0` (required)")
  address: utf8
  @doc("Vulkan ICD JSON a `vulkan` guest's renderer loads, overriding the one picked from the GPU's driver")
  vulkan_icd: utf8?
  @doc("The GPU a lab gets when it names none; at most one block; a lone block is the default without it")
  default: bool?
  @doc("Absolute path to the QEMU every VM on this GPU runs instead of `qemu-system-<arch>` on PATH; its arch must be the VM's")
  qemu_binary: utf8?
  @doc("Variables set in the QEMU process's environment, `{ KEY: \"value\" }`; they win over the Vulkan loader variables vmlab derives")
  @schemaless qemu_env: QemuEnv?
  @doc("Hold the GPU out of runtime suspend from the first virgl/vulkan VM on it until the supervisor stops: `auto` (default; an NVIDIA GPU that can runtime-suspend), `on`, or `off`")
  keepawake: utf8?
}

// `qemu_env`'s shape: a record of strings, keyed by variable name. WCL has
// no map type, so the field is schemaless and the extractor checks each
// value is a string.
type QemuEnv {}
