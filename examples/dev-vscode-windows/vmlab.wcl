// Worked example (PRD §19.8): **VS Code on a Windows domain member.**
//
// The half of §19's parity claim that has a client/server split, a per-user
// `%USERPROFILE%` that does not exist until someone logs on, a minted domain
// logon, and a guest with no route off the segment. Its twin is
// ../dev-neovim-container, which has none of those — one contract, both
// machine kinds.
//
// Prerequisite — build the Windows template first:
//
//   (cd ../templates/windows-server-2025 && ./fetch-deps.sh && vmlab template build)
//
// Then:
//
//   vmlab up                 # dc01 becomes PROBE, dev01 joins it and is provisioned
//   vmlab dev attach         # waits for `attachable`, prints the alias, opens a shell
//   code --remote ssh-remote+vmlab-dev-vscode-windows-dev01 C:\src
//
// The workspace is ./workspace on the host; it syncs both ways (§19.6), and
// it is the *only* thing here that is not a declaration.

import <vmlab.wcl>

lab "dev-vscode-windows" {

  // The domain segment, deliberately with **no `nat`**: this guest has no
  // route off the segment at all, which is the case §19 exists for. VS Code
  // Remote-SSH still attaches, because `"remote.SSH.localServerDownload":
  // "always"` makes the *client* fetch the 12 MB server and push it over
  // `scp` — a client-side setting, which is why `vmlab ssh-config --print`
  // and `vmlab dev attach` hand you the snippet rather than configuring it.
  //
  // To reach a host-side service from here — a package mirror, a proxy, a
  // licence server — add a segment with egress and a second NIC on it
  // (§19.8). `ssh -R` is refused (§19.3) and is not what that needs:
  //
  //   segment "services" { subnet = "10.61.0.0/24" nat = true }
  //   …and on dev01:  nic { segment = "services" }
  //
  // NAT terminates guest flows in-process and proxies them over ordinary
  // host sockets, so anything addressed off-segment reaches the host's own
  // address.
  segment "corp" {
    subnet = "10.60.0.0/24"
    dns { server = "10.60.0.10" }   // AD owns DNS on a domain segment
  }

  vm "dc01" {
    template = "x86_64/windows-server-2025"
    cpus     = 4
    memory   = 8GiB
    nic { segment = "corp" ip = "10.60.0.10" }

    // Promotes the forest, creates PROBE\dev, and publishes \\dc01\team —
    // the domain share the attached terminal reaches in the README's last
    // step.
    provision "scripts/domain.ws" { }
  }

  // The dev machine. `@dev` states something *about* it (§19.1): vmlab
  // publishes it as an SSH endpoint an editor attaches into, and syncs
  // ./workspace onto it. Nothing the decorator carries is a setting the
  // guest ever sees.
  // ANCHOR: dev01
  @dev(default = true, workspace = "./workspace")
  vm "dev01" {
    template   = "x86_64/windows-server-2025"
    cpus       = 4
    memory     = 8GiB
    depends_on = ["dc01"]
    nic { segment = "corp" }

    // Who a surface attaches as (§19.2). The default login is the domain
    // user, so `vmlab dev attach`, the SSH facade's shell, its sftp
    // subsystem and `vmlab exec` all land on **one** minted logon — which is
    // what makes `dir \\dc01\team` work from the editor's terminal.
    //
    // The secret is written plainly because the account exists only because
    // scripts/domain.ws created it, with the same string, six lines away.
    login "dev"   { user = "PROBE\\dev"           password = "vmlab123!" default = true }
    login "admin" { user = "PROBE\\Administrator" password = "vmlab123!" }

    // Declaration order is run order. Join first, then place the editor bits
    // into the domain user's home — which at that moment does not exist yet.
    provision "scripts/join-domain.ws" { }
    provision "scripts/editor-bits.ws" { }
  }
  // ANCHOR_END: dev01
}
