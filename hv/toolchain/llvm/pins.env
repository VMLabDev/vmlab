# Pinned LLVM for the aarch64 decoder of phase 3d (DESIGN.md G1).
#
# Every input that the Containerfile fetches from the network is pinned here
# by content (a digest) or by git commit. Bump a pin by editing this file,
# then run `just tcg-a64-pin` and `just tcg-a64-generate` in hv/.

# Base image (debian:12-slim), the same digest as toolchain/sail.
DEBIAN_BOOKWORM_SLIM_DIGEST=sha256:a3bba7dc7dbcc1f37c2856c51fc9a7fac96608f50cb87b1b4e4d8b8c85ae988e

# llvm-project. The tag is for people, the commit is what is fetched.
LLVM_TAG=llvmorg-23.1.4
LLVM_COMMIT=7a941dfb2877a0b8cf30323fefa85ad019e0b0f5

# The sha256 of each .td file that `llvm-tblgen --dump-json AArch64.td` reads
# is in td.sha256 beside this file (sha256sum format, paths from the root of
# llvm-project). dump.sh checks every file that tblgen read against it and
# fails on a file that is not listed.

# sha256 of the JSON dump made by the pinned llvm-tblgen. It is 100 MB and
# not committed. The generate recipes check it.
LLVM_AARCH64_JSON_SHA256=22741631ef3adfdb8248891180a2b83176d816eb4ef3a746a9f19365755d5631
