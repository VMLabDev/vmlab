# Pinned Berkeley TestFloat for the FP helpers of the aarch64 emulator
# (phase 3d, DESIGN.md O5). `just tcg-a64-testfloat` in hv/ fetches both
# archives, checks them and builds `testfloat_gen`. Nothing of them is
# committed, and `just ci::check` does not fetch them: it replays the sample
# in crates/vmlab-hv-tcg-aarch64/tests/testfloat.txt.

# berkeley-testfloat-3 (BSD-3-Clause): the commit, and the sha256 of its
# archive from GitHub.
TESTFLOAT_COMMIT=a9c849f1b0eb0264b626d9686ffae167d996e3be
TESTFLOAT_SHA256=54852fd1d11f0109011e54d69952cda097d3c49709ce46e4800353a6e8c764c3

# berkeley-softfloat-3 (BSD-3-Clause) at the commit that is vendored in
# crates/vmlab-hv-tcg/vendor/softfloat. The generator is built against these
# upstream sources, not against the vendored copy, so that its results are
# independent of our build.
SOFTFLOAT_COMMIT=0a5ad290c6b287f6605bb99a35ad0842c1e61aa5
SOFTFLOAT_SHA256=b646bbef1883c8b50920ec3414307327a599818a4f72c5fc36629f9d6c9052bd
