# Pinned Sail toolchain for the phase-3 TCG pipeline.
#
# Every input the Containerfile fetches from the network is pinned here by
# content (sha256) or by git commit (git hashes are content-addressed).
# Bump a pin by editing this file only; recipes and the Containerfile read
# their values from here via docker build args.

# Base image (debian:12-slim, digest-pinned so apt contents cannot drift).
# amd64 image manifest digest, verified against registry-1.docker.io 2026-10-31.
DEBIAN_BOOKWORM_SLIM_DIGEST=sha256:a3bba7dc7dbcc1f37c2856c51fc9a7fac96608f50cb87b1b4e4d8b8c85ae988e

# opam 2.5.1 static linux/amd64 binary, from
# https://github.com/ocaml/opam/releases/download/2.5.1/opam-2.5.1-x86_64-linux
OPAM_VERSION=2.5.1
OPAM_SHA256=33705e328d9f740026ce182079e2457639791bcf04a0e4bafbdb2024dd4d6092

# The opam repository commit the switch is resolved against. Note:
# opam-repository periodically rewrites its history, which can make an
# older pin unfetchable ("not our ref" — this already happened to the
# original 2026-10-31 snapshot, ef9f0e92). If it happens again, re-pin to
# the current master tip and record the change here; sail 0.20.3 and
# ocaml 5.2.1 are exact-pinned, so only transitive dependency versions
# can drift between repo snapshots.
OPAM_REPO_COMMIT=a1f0fcbd9384bce190ac51678bf1c2637a6a5cf4

# OCaml compiler switch (matches the research notes/01 stack).
OCAML_VERSION=5.2.1

# The Sail compiler, installed from the opam repository above.
SAIL_VERSION=0.20.3

# sha256 of lib/rts.c in the installed sail 0.20.3, which
# patches/rts-weak-emulator-memory.patch is generated against.
SAIL_RTS_C_SHA256=8ccb5e2a178694adc5d92c826eef29dd648b3241ced30e4cd8822d2fc6b912c3

# isla (rems-project/isla): provides the isla-sail Jib-dump plugin.
# Master as of 2026-10-31; parses sail 0.20.3 and current sail-riscv.
ISLA_COMMIT=e9b5d945394277656593a0d429466d7fa0a2b4b3

# sail-riscv model (riscv/sail-riscv).
SAIL_RISCV_COMMIT=fc074f99f578954376214c4ca9490152d35d0ec2

# Model configuration used for both the Jib IR and the C++ oracle so the
# lockstep harness compares like with like. RV64GC + H + V, VLEN 128, ELEN 64.
RISCV_CONFIG=rv64d_v128_e64
