# In-tree vmlab-hv task runner

# Run repository-wide verification from the root with just ci::check.

[default, private]
main:
	@just --list

# Build the workspace
[group('dev')]
workspace-build:
	cargo build --workspace

# Run the workspace tests
[group('dev')]
workspace-test:
	cargo test --workspace

# Emit the committed RISC-V builders from the pinned toolchain's textual Jib
[group('tcg')]
tcg-generate $ir='target/tcg/riscv64.ir': tcg-ir-generate
	cargo run --release -p vmlab-hv-tcg-emit -- "$ir" crates/vmlab-hv-tcg-riscv64/src

# Regenerate in memory and compare both committed generated artifacts
[group('tcg')]
tcg-generate-check $ir='target/tcg/riscv64.ir': tcg-ir-generate
	cargo run --release -p vmlab-hv-tcg-emit -- "$ir" crates/vmlab-hv-tcg-riscv64/src --check

# Tag of the LLVM tools container image (toolchain/llvm/pins.env pins its inputs)
a64_image := "vmlab-hv-llvm-toolchain:23.1.4"
a64_crate := "crates/vmlab-hv-tcg-aarch64"

# Build the pinned LLVM tools container image from toolchain/llvm/pins.env
[private]
tcg-a64-image-build:
	#!/usr/bin/env bash
	set -euo pipefail
	cd toolchain/llvm
	args=()
	while IFS='=' read -r key value; do
		case "$key" in ''|'#'*|LLVM_AARCH64_JSON_SHA256) continue ;; esac
		args+=(--build-arg "$key=$value")
	done < pins.env
	docker build --memory 16g --memory-swap 16g -f Containerfile "${args[@]}" -t {{a64_image}} .

# Dump the AArch64 TableGen records of the pinned LLVM as JSON into target/tcg/; llvm=container builds the pinned tools, llvm=host uses llvm-tblgen from PATH on the pinned sources
[group('tcg')]
tcg-a64-dump llvm='container':
	#!/usr/bin/env bash
	set -euo pipefail
	mkdir -p target/tcg
	case "{{llvm}}" in
	container)
		just tcg-a64-image-build
		docker run --rm --network none --memory 8g --memory-swap 8g --user "$(id -u):$(id -g)" \
			-v "$PWD/target/tcg":/out {{a64_image}} /opt/scripts/dump.sh /out ;;
	host)
		toolchain/llvm/scripts/fetch-src.sh "$PWD/target/tcg/llvm-src"
		LLVM_SRC="$PWD/target/tcg/llvm-src" TD_SHA256="$PWD/toolchain/llvm/td.sha256" \
			toolchain/llvm/scripts/dump.sh "$PWD/target/tcg" ;;
	*) echo "llvm is container or host" >&2; exit 2 ;;
	esac
	want=$(sed -n 's/^LLVM_AARCH64_JSON_SHA256=//p' toolchain/llvm/pins.env)
	echo "$want  target/tcg/aarch64.json" | sha256sum -c -

# Write toolchain/llvm/td.sha256 from the .td files that the dump reads (after a change of the LLVM pin)
[group('tcg')]
tcg-a64-pin:
	toolchain/llvm/scripts/fetch-src.sh "$PWD/target/tcg/llvm-src"
	mkdir -p target/tcg
	PIN=1 LLVM_SRC="$PWD/target/tcg/llvm-src" TD_SHA256="$PWD/toolchain/llvm/td.sha256" toolchain/llvm/scripts/dump.sh "$PWD/target/tcg"
	@echo "now set LLVM_AARCH64_JSON_SHA256 in toolchain/llvm/pins.env to:" && cut -d' ' -f1 target/tcg/aarch64.json.sha256

# The llvm-mc that the decoder recipes start: the one of the container image, or the one on PATH
[private]
tcg-a64-llvm-mc llvm:
	@case "{{llvm}}" in container) echo "$PWD/toolchain/llvm/scripts/llvm-mc-container.sh" ;; host) command -v llvm-mc ;; *) echo "llvm is container or host" >&2; exit 2 ;; esac

# Generate the committed aarch64 decoder, system register tables and decoder vectors from the pinned LLVM tables
[group('tcg')]
tcg-a64-generate llvm='container': (tcg-a64-dump llvm)
	cargo run --release -p vmlab-hv-tcg-a64gen -- target/tcg/aarch64.json {{a64_crate}}
	A64_LLVM_IMAGE={{a64_image}} cargo run --release -p vmlab-hv-tcg-aarch64 --example a64_mc -- --llvm-mc "$(just tcg-a64-llvm-mc {{llvm}})" --vectors-out {{a64_crate}}/tests/vectors.txt

# Regenerate in memory and compare the three committed aarch64 decoder artifacts
[group('tcg')]
tcg-a64-generate-check llvm='container': (tcg-a64-dump llvm)
	cargo run --release -p vmlab-hv-tcg-a64gen -- target/tcg/aarch64.json {{a64_crate}} --check
	A64_LLVM_IMAGE={{a64_image}} cargo run --release -p vmlab-hv-tcg-aarch64 --example a64_mc -- --llvm-mc "$(just tcg-a64-llvm-mc {{llvm}})" --vectors-check {{a64_crate}}/tests/vectors.txt

# Compare the aarch64 decoder with `llvm-mc --show-inst` on random words of the selected sets
[group('tcg')]
tcg-a64-decode-check count='10000000' seed='1' llvm='container' jobs='8':
	if [ "{{llvm}}" = container ]; then just tcg-a64-image-build; fi
	A64_LLVM_IMAGE={{a64_image}} cargo run --release -p vmlab-hv-tcg-aarch64 --example a64_mc -- --llvm-mc "$(just tcg-a64-llvm-mc {{llvm}})" --count {{count}} --seed {{seed}} --jobs {{jobs}}

# Build the QEMU plugin of the aarch64 lockstep into target/tcg/ (needs gcc, glib and qemu-plugin.h)
[private]
tcg-a64-plugin-build:
	@mkdir -p target/tcg
	gcc -O2 -Wall -Werror -shared -fPIC $(pkg-config --cflags glib-2.0) -o target/tcg/a64lock.so {{a64_crate}}/plugin/a64lock.c

# Run the aarch64 instruction lockstep against QEMU for a group (DESIGN.md O3: c1, dp-immediate, branch, or fp, which also compares V0 to V31, FPSR and FPCR); traces are files of the measure plugin with the executed encodings, separated by spaces
[group('tcg')]
tcg-a64-lockstep group='c1' per_class='100000' seed='1' traces='' corpus='' samples='3': tcg-a64-plugin-build
	#!/usr/bin/env bash
	set -euo pipefail
	dir=$(mktemp -d "${TMPDIR:-/tmp}/a64lock.XXXXXX")
	trap '[ -n "$dir" ] && [ -d "$dir" ] && rm -rf -- "$dir"' EXIT
	args=(--plugin "$PWD/target/tcg/a64lock.so" --dir "$dir" --group "{{group}}" --per-class "{{per_class}}" --seed "{{seed}}" --samples "{{samples}}")
	for trace in {{traces}}; do args+=(--encodings "$trace"); done
	if [ -n "{{corpus}}" ]; then args+=(--corpus-out "{{corpus}}"); fi
	cargo run --release -p vmlab-hv-tcg-aarch64 --example a64_lockstep -- "${args[@]}"

# Run Berkeley TestFloat against the FP helpers of the aarch64 emulator (DESIGN.md O5); it fetches and builds the pinned generator of toolchain/testfloat/pins.env, and sample is a file that takes test cases for tests/testfloat.rs
[group('tcg')]
tcg-a64-testfloat level='1' sample='':
	#!/usr/bin/env bash
	set -euo pipefail
	gen=$(toolchain/testfloat/build.sh "$PWD/target/tcg/testfloat")
	args=(--gen "$gen" --level "{{level}}")
	if [ -n "{{sample}}" ]; then args+=(--sample-out "{{sample}}"); fi
	cargo run --release -p vmlab-hv-tcg-aarch64 --example a64_testfloat -- "${args[@]}"

# Measure the aarch64 interpreter loop on the branch-and-add image (DESIGN.md M6)
[group('tcg')]
tcg-a64-mips iterations='100000000' repeats='3':
	cargo run --release -p vmlab-hv-tcg-aarch64 --example a64_mips -- {{iterations}} {{repeats}}

# Build the pinned legacy and EFI virtio-net option ROMs
[group('dev')]
firmware-ipxe-build:
	uv run python ../guest/ipxe/build.py --profile hv

# Pin the Alpine minirootfs the S1 rootfs builds from
alpine_url := "https://dl-cdn.alpinelinux.org/alpine/v3.22/releases/x86_64/alpine-minirootfs-3.22.1-x86_64.tar.gz"
alpine_sha := "0e5cc5702ad72a4e151f219976ba946d50161c3acce210ef3b122a529aba1270"

# Fetch (once, cached under target/) and verify the pinned Alpine minirootfs
[group('test')]
s1-tarball:
	@mkdir -p target/s1
	@test -f target/s1/alpine.tar.gz || curl -fsSL -o target/s1/alpine.tar.gz {{alpine_url}}
	@echo "{{alpine_sha}}  target/s1/alpine.tar.gz" | sha256sum -c -

# Build the reproducible squashfs rootfs the S1 tests boot (needs sqfstar)
[group('test')]
s1-rootfs-build: s1-tarball
	@command -v sqfstar > /dev/null || (echo 'sqfstar is required to build the S1 rootfs' && exit 1)
	@bash -euo pipefail -c 'gzip -dc target/s1/alpine.tar.gz | sqfstar -no-xattrs -all-root -mkfs-time 0 -all-time 0 -processors 2 -comp gzip -force target/s1/rootfs.sqfs'

# Run the S1 integration suite against the built rootfs
[group('test')]
s1-tests-run: s1-rootfs-build
	cargo test -p vmlab-hv-tests -- --nocapture

# Tag of the Sail toolchain container image (toolchain/sail/pins.env pins it)
tcg_image := "vmlab-hv-sail-toolchain:0.20.3"

# Build the pinned Sail toolchain container image from toolchain/sail/pins.env
[private]
tcg-image-build:
	#!/usr/bin/env bash
	set -euo pipefail
	cd toolchain/sail
	args=()
	while IFS='=' read -r key value; do
		case "$key" in ''|'#'*|DEBIAN_BOOKWORM_SLIM_DIGEST) continue ;; esac
		args+=(--build-arg "$key=$value")
	done < pins.env
	docker build --memory 16g --memory-swap 16g -f Containerfile "${args[@]}" -t {{tcg_image}} .

# Emit the textual Jib IR for the pinned sail-riscv model into target/tcg/
[group('tcg')]
tcg-ir-generate: tcg-image-build
	@mkdir -p target/tcg
	docker run --rm --memory 12g --memory-swap 12g --user "$(id -u):$(id -g)" \
		-v "$PWD/target/tcg":/out {{tcg_image}} /opt/scripts/gen-ir.sh
	cd target/tcg && sha256sum -c riscv64.ir.sha256

# Prove the Jib IR generation is deterministic: two runs, identical bytes
[group('tcg')]
tcg-ir-repro-check: tcg-image-build
	#!/usr/bin/env bash
	set -euo pipefail
	tmp=$(mktemp -d)
	trap 'rm -rf "$tmp"' EXIT
	for run in "$tmp/run1" "$tmp/run2"; do
		mkdir -p "$run"
		docker run --rm --memory 12g --memory-swap 12g --user "$(id -u):$(id -g)" \
			-v "$run":/out {{tcg_image}} /opt/scripts/gen-ir.sh
	done
	cmp "$tmp/run1/riscv64.ir" "$tmp/run2/riscv64.ir"
	echo "tcg-ir-repro-check: byte-identical ($(sha256sum < "$tmp/run1/riscv64.ir" | cut -d' ' -f1))"

# Build the Sail C++ model oracle library into target/tcg/oracle/
[group('tcg')]
tcg-oracle-build: tcg-image-build
	@mkdir -p target/tcg/oracle
	docker run --rm --memory 12g --memory-swap 12g --user "$(id -u):$(id -g)" \
		-v "$PWD/target/tcg/oracle":/out {{tcg_image}} /opt/scripts/build-oracle.sh

# Link the oracle library and step a hand-assembled RV64 program through the model
[group('tcg')]
tcg-oracle-test: tcg-oracle-build
	cargo test --manifest-path toolchain/sail/oracle-test/Cargo.toml

# Run the D2 TCG benchmark suite (bench/README.md); backend qemu|vmlab-hv,
# or the interpreter backends and the flat qemu TCG baseline with guest=flat-rv64gc
[group('bench')]
bench-run backend="qemu" arch="all" vcpus="1,4" repeats="3" guest="debian-13": (bench-hv-binary backend)
	python3 bench/run.py --backend {{backend}} --arch {{arch}} --vcpus {{vcpus}} --repeats {{repeats}} --guest {{guest}}

# Run the phase-2 x86_64 KVM suite (HV-D28): guest ubuntu-26.04|windows-10;
# vcpus left empty means the template's own count
[group('bench')]
bench-run-kvm backend="qemu" guest="ubuntu-26.04" repeats="3" vcpus="": (bench-hv-binary backend) (bench-ipxe-rom backend)
	#!/usr/bin/env bash
	set -eu
	args=(--backend "{{backend}}" --arch x86_64 --guest "{{guest}}" --repeats "{{repeats}}")
	if [ -n "{{vcpus}}" ]; then args+=(--vcpus "{{vcpus}}"); fi
	python3 bench/run.py "${args[@]}"

# Run the x86_64 guest-to-guest net pair (two VMs at once, HV-D28)
[group('bench')]
bench-run-g2g backend="qemu" guest="ubuntu-26.04" repeats="3": (bench-hv-binary backend) (bench-ipxe-rom backend)
	python3 bench/run.py --backend {{backend}} --arch x86_64 --suite g2g --guest {{guest}} --repeats {{repeats}}

# Print the per-workload trend from bench/history
[group('bench')]
bench-report arch="all" backend="all" guest="all":
	python3 bench/report.py --arch {{arch}} --backend {{backend}} --guest {{guest}}

# Fail if the latest run regressed beyond measured noise for its backend
[group('bench')]
bench-check arch="all" backend="all":
	python3 bench/check.py --arch {{arch}} --backend {{backend}}

# Run the bench suite's own unit tests
[group('bench')]
bench-test:
	cd bench && python3 -m unittest

# Build the release binary the vmlab-hv bench backend needs (no-op for qemu)
[private]
bench-hv-binary backend:
	@if [ "{{backend}}" = "vmlab-hv" ]; then cargo build --release -p vmlab-hv; fi

# Build the iPXE ROM the vmlab-hv x86_64 NIC carries (no-op for qemu)
[private]
bench-ipxe-rom backend:
	@if [ "{{backend}}" = "vmlab-hv" ] && [ ! -f target/ipxe/virtio-net.rom ]; then uv run python ../guest/ipxe/build.py --profile hv; fi
