# Every workspace's build dir: the main crate plus the standalone ones
# (ebpf/, tap/, guest/cinit, guest/agent, and the two proto crates).
/target
/ebpf/target
/tap/target
/guest/*/target
/.vmlab
*.wscripti
examples/**/.vmlab/
docker/lab/.vmlab/

# Generated documentation site + wskill projections (regenerate with `just docs-build` / `just skill-build`).
/docs/_site
/docs/wskills/*/out
# The in-app help book (`just help-build`); .gitkeep stays so rust-embed's
# folder exists on a fresh checkout.
/docs/help/*
!/docs/help/.gitkeep
.playwright-cli/

# `just peer-demo` scratch homes (two isolated vmlab instances).
/.vmlab-peer-demo/

# config-weave's package-repo clones, written beside a playbook whenever
# `pkg search|add` runs (the sample labs under docker/ are real playbooks).
.repo-cache/
