// One aarch64 VM with no template: a blank disk under emulation on an x86_64
// host — vmlab-hv's emulated `virt` machine on a vmlab run, QEMU's TCG on a
// QEMU run. Nothing boots from the disk, but the firmware reaches its UEFI
// banner on the serial console, which is what `arch.emulated` waits for.
import <vmlab.wcl>

lab "e2e-admin" {
  vm "arm01" {
    template = "scratch"
    arch     = "aarch64"
    profile  = "linux-modern"
    cpus     = 1
    memory   = 512MiB
    disk     = 1GiB
  }
}
