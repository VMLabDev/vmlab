// `disk { from }` with a folder relative to the lab root, as the reference
// writes it. `vmlab up` should build the FAT disk and boot.
import <vmlab.wcl>

lab "e2e-core-diskfrom" {
  vm "vm01" {
    template = "x86_64/e2e-alpine"
    cpus     = 1
    memory   = 512MiB
    disk "payload" { from = "./payload/" }
  }
}
