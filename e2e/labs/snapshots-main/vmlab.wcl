// Snapshots: one VM and one idle container, snapshotted online, offline and
// lab-wide, plus two idle containers for the clock a restore leaves: one that
// keeps the restored time and one started at a fixed date.
import <vmlab.wcl>

lab "e2e-snapshots" {
  segment "lan" { subnet = "10.85.0.0/24" }

  vm "vm01" {
    template = "x86_64/e2e-alpine"
    cpus     = 1
    memory   = 512MiB
    nic { segment = "lan" }
  }

  container "c01" {
    image   = "alpine:3.22"
    profile = "container"
    mode    = :idle
    nic { segment = "lan" }
  }

  container "c02" {
    image   = "alpine:3.22"
    profile = "container"
    mode    = :idle
    clock   = "snapshot"
    nic { segment = "lan" }
  }

  container "c03" {
    image   = "alpine:3.22"
    profile = "container"
    mode    = :idle
    clock   = "2020-01-01T00:00:00Z"
    nic { segment = "lan" }
  }
}
