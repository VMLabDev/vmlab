+uint64_t
+vkr_gt_now(void);
+
+/* The batches of a vkQueueSubmit or vkQueueSubmit2 whose handles the decoder
+ * has not replaced yet; free() the result. NULL when the trace is off. */
+struct vkr_gt_batch *
+vkr_gt_batches(const VkSubmitInfo *submits, uint32_t count);
+
+struct vkr_gt_batch *
+vkr_gt_batches2(const VkSubmitInfo2 *submits, uint32_t count);
+
+/* The objects that descriptor writes name: as slots of their sets
