diff --git a/src/venus/vkr_command_buffer.c b/src/venus/vkr_command_buffer.c
index 95a6be9..f487a89 100644
--- a/src/venus/vkr_command_buffer.c
+++ b/src/venus/vkr_command_buffer.c
@@ -7,6 +7,69 @@
 
 #include "vkr_command_buffer_gen.h"
 
+#include "vkr_gputrace.h"
+
+/* card #237: what a command buffer touches, for the GPU trace */
+#define GT_USE(args, handle, flags)                                                      \
+   do {                                                                                  \
+      if (vkr_gt_on())                                                                   \
+         vkr_gt_link(VKR_GT_ID((args)->commandBuffer), VKR_GT_ID(handle), (flags));      \
+   } while (0)
+
+static void
+gt_barriers(uint64_t cb,
+            uint32_t buffer_count,
+            const VkBufferMemoryBarrier *buffers,
+            uint32_t image_count,
+            const VkImageMemoryBarrier *images)
+{
+   for (uint32_t i = 0; buffers && i < buffer_count; i++)
+      vkr_gt_link(cb, VKR_GT_ID(buffers[i].buffer), VKR_GT_BARRIER);
+   for (uint32_t i = 0; images && i < image_count; i++)
+      vkr_gt_link(cb, VKR_GT_ID(images[i].image), VKR_GT_BARRIER);
+}
+
+static void
+gt_dependency(uint64_t cb, const VkDependencyInfo *info)
+{
+   for (uint32_t i = 0; info && info->pBufferMemoryBarriers && i < info->bufferMemoryBarrierCount; i++)
+      vkr_gt_link(cb, VKR_GT_ID(info->pBufferMemoryBarriers[i].buffer), VKR_GT_BARRIER);
+   for (uint32_t i = 0; info && info->pImageMemoryBarriers && i < info->imageMemoryBarrierCount; i++)
+      vkr_gt_link(cb, VKR_GT_ID(info->pImageMemoryBarriers[i].image), VKR_GT_BARRIER);
+}
+
+static void
+gt_render_pass(uint64_t cb, const VkRenderPassBeginInfo *info)
+{
+   if (!info)
+      return;
+   vkr_gt_link(cb, VKR_GT_ID(info->framebuffer), VKR_GT_WRITE);
+   const VkRenderPassAttachmentBeginInfo *views =
+      vkr_find_struct(info->pNext, VK_STRUCTURE_TYPE_RENDER_PASS_ATTACHMENT_BEGIN_INFO);
+   for (uint32_t i = 0; views && views->pAttachments && i < views->attachmentCount; i++)
+      vkr_gt_link(cb, VKR_GT_ID(views->pAttachments[i]), VKR_GT_WRITE);
+}
+
+static void
+gt_rendering_attachment(uint64_t cb, const VkRenderingAttachmentInfo *a)
+{
+   if (!a)
+      return;
+   vkr_gt_link(cb, VKR_GT_ID(a->imageView), VKR_GT_WRITE);
+   vkr_gt_link(cb, VKR_GT_ID(a->resolveImageView), VKR_GT_WRITE);
+}
+
+static void
+gt_rendering(uint64_t cb, const VkRenderingInfo *info)
+{
+   if (!info)
+      return;
+   for (uint32_t i = 0; info->pColorAttachments && i < info->colorAttachmentCount; i++)
+      gt_rendering_attachment(cb, &info->pColorAttachments[i]);
+   gt_rendering_attachment(cb, info->pDepthAttachment);
+   gt_rendering_attachment(cb, info->pStencilAttachment);
+}
+
