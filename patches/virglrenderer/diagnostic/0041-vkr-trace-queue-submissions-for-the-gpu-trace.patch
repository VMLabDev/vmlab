diff --git a/src/venus/vkr_gputrace.c b/src/venus/vkr_gputrace.c
new file mode 100644
index 0000000..71b17ee
--- /dev/null
+++ b/src/venus/vkr_gputrace.c
@@ -0,0 +1,597 @@
+/*
+ * Diagnostics only (vmlab card #237): see vkr_gputrace.h.
+ */
+#include "vkr_gputrace.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#include <unistd.h>
+
+#include "vkr_context.h"
+#include "vkr_device.h"
+#include "vkr_queue.h"
+
+/* -1 undecided, 0 off, 1 on */
+static int gt_state = -1;
+static once_flag gt_once = ONCE_FLAG_INIT;
+static mtx_t gt_mutex;
+static FILE *gt_file;
+static uint64_t gt_flushed_ns;
+static uint64_t gt_seq;
+
+uint64_t
+vkr_gt_now(void)
+{
+   struct timespec ts;
+   clock_gettime(CLOCK_MONOTONIC, &ts);
+   return (uint64_t)ts.tv_sec * 1000000000ull + (uint64_t)ts.tv_nsec;
+}
+
+static void
+gt_atexit(void)
+{
+   mtx_lock(&gt_mutex);
+   if (gt_file)
+      fflush(gt_file);
+   mtx_unlock(&gt_mutex);
+}
+
+static void
+gt_init(void)
+{
+   mtx_init(&gt_mutex, mtx_plain);
+   const char *dir = getenv("VMLAB_HV_GPU_TRACE");
+   gt_state = 0;
+   if (!dir || !*dir)
+      return;
+   char path[512];
+   snprintf(path, sizeof(path), "%s/gpu-trace-%d.txt", dir, (int)getpid());
+   gt_file = fopen(path, "a");
+   if (!gt_file) {
+      vkr_log("GPU trace: cannot open %s", path);
+      return;
+   }
+   setvbuf(gt_file, NULL, _IOFBF, 1 << 20);
+   vkr_log("GPU trace: writing %s", path);
+   atexit(gt_atexit);
+   gt_state = 1;
+}
+
+bool
+vkr_gt_on(void)
+{
+   if (gt_state < 0)
+      call_once(&gt_once, gt_init);
+   return gt_state == 1;
+}
+
+/* The caller holds gt_mutex. Lines are written out at most every 100 ms. */
+static void
+gt_line_locked(uint64_t at_ns, const char *line)
+{
+   fprintf(gt_file, "%" PRIu64 " %s\n", at_ns, line);
+   const uint64_t now = vkr_gt_now();
+   if (now - gt_flushed_ns >= 100000000ull) {
+      fflush(gt_file);
+      gt_flushed_ns = now;
+   }
+}
+
+/* The object graph: an open-addressed table of guest object ids. Ids are
+ * never reused within a context, so entries are never removed. */
+struct gt_edge {
+   uint64_t child;
+   uint32_t slot; /* descriptor slot + 1, or 0 */
+   uint32_t flags;
+};
+
+struct gt_node {
+   uint64_t id;
+   uint32_t res;
+   uint32_t count, cap;
+   struct gt_edge *edges;
+};
+
+static struct gt_node **gt_table;
+static size_t gt_cap, gt_len;
+
+static size_t
+gt_hash(uint64_t id)
+{
+   id ^= id >> 33;
+   id *= 0xff51afd7ed558ccdull;
+   id ^= id >> 33;
+   return (size_t)id;
+}
+
+static struct gt_node *
+gt_find(uint64_t id)
+{
+   if (!gt_cap)
+      return NULL;
+   for (size_t i = gt_hash(id) & (gt_cap - 1);; i = (i + 1) & (gt_cap - 1)) {
+      if (!gt_table[i])
+         return NULL;
+      if (gt_table[i]->id == id)
+         return gt_table[i];
+   }
+}
+
+static void
+gt_insert(struct gt_node *node)
+{
+   for (size_t i = gt_hash(node->id) & (gt_cap - 1);; i = (i + 1) & (gt_cap - 1)) {
+      if (!gt_table[i]) {
+         gt_table[i] = node;
+         return;
+      }
+   }
+}
+
+static struct gt_node *
+gt_get(uint64_t id)
+{
+   struct gt_node *node = gt_find(id);
+   if (node)
+      return node;
+   if ((gt_len + 1) * 2 > gt_cap) {
+      struct gt_node **old = gt_table;
+      size_t old_cap = gt_cap;
+      gt_cap = gt_cap ? gt_cap * 2 : 4096;
+      gt_table = calloc(gt_cap, sizeof(*gt_table));
+      if (!gt_table)
+         abort();
+      for (size_t i = 0; i < old_cap; i++) {
+         if (old[i])
+            gt_insert(old[i]);
+      }
+      free(old);
+   }
+   node = calloc(1, sizeof(*node));
+   if (!node)
+      abort();
+   node->id = id;
+   gt_insert(node);
+   gt_len++;
+   return node;
+}
+
+static void
+gt_add_edge(struct gt_node *node, uint64_t child, uint32_t slot, uint32_t flags)
+{
+   for (uint32_t i = 0; i < node->count; i++) {
+      struct gt_edge *e = &node->edges[i];
+      if (slot ? e->slot == slot : (!e->slot && e->child == child)) {
+         e->child = child;
+         e->flags |= flags;
+         return;
+      }
+   }
+   if (node->count == node->cap) {
+      node->cap = node->cap ? node->cap * 2 : 4;
+      node->edges = realloc(node->edges, node->cap * sizeof(*node->edges));
+      if (!node->edges)
+         abort();
+   }
+   node->edges[node->count++] = (struct gt_edge){ child, slot, flags };
+}
+
+void
+vkr_gt_set_res(uint64_t mem, uint32_t res_id)
+{
+   if (!vkr_gt_on() || !mem)
+      return;
+   mtx_lock(&gt_mutex);
+   gt_get(mem)->res = res_id;
+   mtx_unlock(&gt_mutex);
+}
+
+void
+vkr_gt_link(uint64_t parent, uint64_t child, uint32_t flags)
+{
+   if (!vkr_gt_on() || !parent || !child)
+      return;
+   mtx_lock(&gt_mutex);
+   gt_add_edge(gt_get(parent), child, 0, flags);
+   mtx_unlock(&gt_mutex);
+}
+
+void
+vkr_gt_slot(uint64_t set, uint32_t slot, uint64_t child)
+{
+   if (!vkr_gt_on() || !set)
+      return;
+   mtx_lock(&gt_mutex);
+   gt_add_edge(gt_get(set), child, slot + 1, 0);
+   mtx_unlock(&gt_mutex);
+}
+
+void
+vkr_gt_copy_slots(uint64_t src, uint32_t src_slot, uint64_t dst, uint32_t dst_slot,
+                  uint32_t count)
+{
+   if (!vkr_gt_on() || !src || !dst)
+      return;
+   mtx_lock(&gt_mutex);
+   struct gt_node *from = gt_find(src);
+   struct gt_node *to = gt_get(dst);
+   for (uint32_t n = 0; from && n < count; n++) {
+      for (uint32_t i = 0; i < from->count; i++) {
+         if (from->edges[i].slot == src_slot + n + 1) {
+            gt_add_edge(to, from->edges[i].child, dst_slot + n + 1, 0);
+            break;
+         }
+      }
+   }
+   mtx_unlock(&gt_mutex);
+}
+
+void
+vkr_gt_reset(uint64_t id)
+{
+   if (!vkr_gt_on() || !id)
+      return;
+   mtx_lock(&gt_mutex);
+   struct gt_node *node = gt_find(id);
+   if (node)
+      node->count = 0;
+   mtx_unlock(&gt_mutex);
+}
+
+void
+vkr_gt_sem(char *list, size_t size, uint64_t sem, const uint64_t *value)
+{
+   size_t n = strlen(list);
+   if (n + 48 >= size)
+      return;
+   if (value)
+      snprintf(list + n, size - n, "%s%" PRIu64 ":%" PRIu64, n ? "," : "", sem, *value);
+   else
+      snprintf(list + n, size - n, "%s%" PRIu64, n ? "," : "", sem);
+}
+
+#define GT_MAX_RES 128
+
+struct gt_acc {
+   uint32_t res[GT_MAX_RES];
+   uint32_t flags[GT_MAX_RES];
+   uint32_t count;
+};
+
+/* The caller holds gt_mutex. */
+static void
+gt_resolve(uint64_t id, uint32_t flags, int depth, struct gt_acc *acc)
+{
+   struct gt_node *node = gt_find(id);
+   if (!node || depth > 8)
+      return;
+   if (node->res) {
+      uint32_t i = 0;
+      while (i < acc->count && acc->res[i] != node->res)
+         i++;
+      if (i == acc->count && acc->count < GT_MAX_RES) {
+         acc->res[acc->count] = node->res;
+         acc->flags[acc->count++] = 0;
+      }
+      if (i < acc->count)
+         acc->flags[i] |= flags;
+   }
+   for (uint32_t i = 0; i < node->count; i++) {
+      const struct gt_edge *e = &node->edges[i];
+      gt_resolve(e->child, e->flags ? e->flags : flags, depth + 1, acc);
+   }
+}
+
+/* The fence waiter of a queue: vk_done for each traced submission, in the
+ * queue's order. */
+struct gt_pending {
+   struct gt_pending *next;
+   VkFence fence;
+   uint64_t seq;
+};
+
+struct gt_waiter {
+   struct vkr_queue *queue;
+   thrd_t thread;
+   mtx_t mutex;
+   cnd_t cond;
+   struct gt_pending *head, *tail;
+   bool join;
+};
+
+static struct gt_waiter *gt_waiters[16];
+
+static int
+gt_waiter_main(void *data)
+{
+   struct gt_waiter *w = data;
+   struct vkr_device *dev = w->queue->device;
+   struct vn_device_proc_table *vk = &dev->proc_table;
+   const uint32_t ctx_id = w->queue->context->ctx_id;
+   const uint64_t queue_id = w->queue->base.id;
+   for (;;) {
+      mtx_lock(&w->mutex);
+      while (!w->head && !w->join)
+         cnd_wait(&w->cond, &w->mutex);
+      struct gt_pending *p = w->head;
+      if (!p) {
+         mtx_unlock(&w->mutex);
+         return 0;
+      }
+      w->head = p->next;
+      if (!w->head)
+         w->tail = NULL;
+      mtx_unlock(&w->mutex);
+
+      VkResult r = VK_TIMEOUT;
+      for (int tries = 0; tries < 10 && r == VK_TIMEOUT; tries++)
+         r = vk->WaitForFences(dev->base.handle.device, 1, &p->fence, VK_TRUE, 1000000000ull);
+      const uint64_t at = vkr_gt_now();
+      vk->DestroyFence(dev->base.handle.device, p->fence, NULL);
+      char line[160];
+      snprintf(line, sizeof(line), "vk_done ctx=%u seq=%" PRIu64 " queue=%" PRIu64 " ret=%d",
+               ctx_id, p->seq, queue_id, r);
+      mtx_lock(&gt_mutex);
+      gt_line_locked(at, line);
+      mtx_unlock(&gt_mutex);
+      free(p);
+   }
+}
+
+/* The caller holds gt_mutex. */
+static struct gt_waiter *
+gt_waiter_for(struct vkr_queue *queue)
+{
+   for (unsigned i = 0; i < ARRAY_SIZE(gt_waiters); i++) {
+      if (gt_waiters[i] && gt_waiters[i]->queue == queue)
+         return gt_waiters[i];
+   }
+   for (unsigned i = 0; i < ARRAY_SIZE(gt_waiters); i++) {
+      if (gt_waiters[i])
+         continue;
+      struct gt_waiter *w = calloc(1, sizeof(*w));
+      if (!w)
+         return NULL;
+      w->queue = queue;
+      mtx_init(&w->mutex, mtx_plain);
+      cnd_init(&w->cond);
+      if (thrd_create(&w->thread, gt_waiter_main, w) != thrd_success) {
+         free(w);
+         return NULL;
+      }
+      gt_waiters[i] = w;
+      return w;
+   }
+   return NULL;
+}
+
+void
+vkr_gt_queue_fini(struct vkr_queue *queue)
+{
+   if (!vkr_gt_on())
+      return;
+   struct gt_waiter *w = NULL;
+   mtx_lock(&gt_mutex);
+   for (unsigned i = 0; i < ARRAY_SIZE(gt_waiters); i++) {
+      if (gt_waiters[i] && gt_waiters[i]->queue == queue) {
+         w = gt_waiters[i];
+         gt_waiters[i] = NULL;
+      }
+   }
+   mtx_unlock(&gt_mutex);
+   if (!w)
+      return;
+   mtx_lock(&w->mutex);
+   w->join = true;
+   cnd_signal(&w->cond);
+   mtx_unlock(&w->mutex);
+   /* The waiter drains what is queued (the device is idle) and returns. */
+   thrd_join(w->thread, NULL);
+   mtx_destroy(&w->mutex);
+   cnd_destroy(&w->cond);
+   free(w);
+}
+
+static void
+gt_name(char *out, size_t size, const char *name)
+{
+   size_t n = 0;
+   for (; name && *name && n + 1 < size; name++)
+      out[n++] = (*name == ' ' || *name == '=' || *name < 0x21) ? '_' : *name;
+   out[n] = '\0';
+   if (!n)
+      snprintf(out, size, "-");
+}
+
+void
+vkr_gt_submit(struct vkr_queue *queue,
+              const char *kind,
+              const struct vkr_gt_batch *batches,
+              uint32_t batch_count,
+              uint64_t fence,
+              uint64_t begin_ns,
+              VkResult ret)
+{
+   if (!vkr_gt_on())
+      return;
+   const uint64_t end_ns = vkr_gt_now();
+   struct vkr_device *dev = queue->device;
+   struct vn_device_proc_table *vk = &dev->proc_table;
+
+   /* The empty submission behind it, as vkr_queue_sync_submit makes one. */
+   VkFence done = VK_NULL_HANDLE;
+   if (ret == VK_SUCCESS) {
+      const VkFenceCreateInfo info = { .sType = VK_STRUCTURE_TYPE_FENCE_CREATE_INFO };
+      if (vk->CreateFence(dev->base.handle.device, &info, NULL, &done) != VK_SUCCESS)
+         done = VK_NULL_HANDLE;
+      else if (vk->QueueSubmit(queue->base.handle.queue, 0, NULL, done) != VK_SUCCESS) {
+         vk->DestroyFence(dev->base.handle.device, done, NULL);
+         done = VK_NULL_HANDLE;
+      }
+   }
+
+   char name[64];
+   gt_name(name, sizeof(name), queue->context->debug_name);
+   static char line[16384];
+   mtx_lock(&gt_mutex);
+   const uint64_t seq = ++gt_seq;
+   int n = snprintf(line, sizeof(line),
+                    "vk_submit ctx=%u name=%s seq=%" PRIu64 " kind=%s queue=%" PRIu64
+                    " family=%u ring=%u fence=%" PRIu64 " batches=%u us=%" PRIu64 " ret=%d",
+                    queue->context->ctx_id, name, seq, kind, queue->base.id, queue->family,
+                    queue->ring_idx, fence, batch_count, (end_ns - begin_ns) / 1000, ret);
+   struct gt_acc acc = { .count = 0 };
+   for (uint32_t b = 0; b < batch_count && n > 0 && (size_t)n < sizeof(line) - 1024; b++) {
+      const struct vkr_gt_batch *batch = &batches[b];
+      n += snprintf(line + n, sizeof(line) - n, " b%u.wait=%s b%u.signal=%s b%u.cbs=", b,
+                    batch->waits[0] ? batch->waits : "-", b,
+                    batch->signals[0] ? batch->signals : "-", b);
+      for (uint32_t c = 0; c < batch->cb_count && (size_t)n < sizeof(line) - 1024; c++) {
+         n += snprintf(line + n, sizeof(line) - n, "%s%" PRIu64, c ? "," : "", batch->cbs[c]);
+         gt_resolve(batch->cbs[c], 0, 0, &acc);
+      }
+      if (!batch->cb_count)
+         n += snprintf(line + n, sizeof(line) - n, "-");
+   }
+   n += snprintf(line + n, sizeof(line) - n, " res=");
+   for (uint32_t i = 0; i < acc.count && (size_t)n < sizeof(line) - 32; i++) {
+      const uint32_t f = acc.flags[i];
+      n += snprintf(line + n, sizeof(line) - n, "%s%u:%s%s%s%s", i ? "," : "", acc.res[i],
+                    f & VKR_GT_WRITE ? "w" : "", f & VKR_GT_READ ? "r" : "",
+                    f & VKR_GT_DESCRIPTOR ? "d" : "", f & VKR_GT_BARRIER ? "b" : "");
+   }
+   if (!acc.count)
+      snprintf(line + n, sizeof(line) - n, "-");
+   gt_line_locked(begin_ns, line);
+
+   struct gt_waiter *w = done != VK_NULL_HANDLE ? gt_waiter_for(queue) : NULL;
+   mtx_unlock(&gt_mutex);
+   if (done == VK_NULL_HANDLE)
+      return;
+   struct gt_pending *p = w ? calloc(1, sizeof(*p)) : NULL;
+   if (!p) {
+      vk->QueueWaitIdle(queue->base.handle.queue);
+      vk->DestroyFence(dev->base.handle.device, done, NULL);
+      return;
+   }
+   p->fence = done;
+   p->seq = seq;
+   mtx_lock(&w->mutex);
+   if (w->tail)
+      w->tail->next = p;
+   else
+      w->head = p;
+   w->tail = p;
+   cnd_signal(&w->cond);
+   mtx_unlock(&w->mutex);
+}
+
+struct vkr_gt_batch *
+vkr_gt_batches(const VkSubmitInfo *submits, uint32_t count)
+{
+   if (!vkr_gt_on() || !count)
+      return NULL;
+   struct vkr_gt_batch *out = calloc(count, sizeof(*out));
+   if (!out)
+      return NULL;
+   for (uint32_t i = 0; i < count; i++) {
+      const VkSubmitInfo *s = &submits[i];
+      const VkTimelineSemaphoreSubmitInfo *tl =
+         vkr_find_struct(s->pNext, VK_STRUCTURE_TYPE_TIMELINE_SEMAPHORE_SUBMIT_INFO);
+      for (uint32_t j = 0; j < s->waitSemaphoreCount; j++)
+         vkr_gt_sem(out[i].waits, sizeof(out[i].waits), VKR_GT_ID(s->pWaitSemaphores[j]),
+                    tl && tl->pWaitSemaphoreValues && j < tl->waitSemaphoreValueCount
+                       ? &tl->pWaitSemaphoreValues[j]
+                       : NULL);
+      for (uint32_t j = 0; j < s->signalSemaphoreCount; j++)
+         vkr_gt_sem(out[i].signals, sizeof(out[i].signals),
+                    VKR_GT_ID(s->pSignalSemaphores[j]),
+                    tl && tl->pSignalSemaphoreValues && j < tl->signalSemaphoreValueCount
+                       ? &tl->pSignalSemaphoreValues[j]
+                       : NULL);
+      for (uint32_t j = 0; j < s->commandBufferCount && j < ARRAY_SIZE(out[i].cbs); j++)
+         out[i].cbs[out[i].cb_count++] = VKR_GT_ID(s->pCommandBuffers[j]);
+   }
+   return out;
+}
+
+struct vkr_gt_batch *
+vkr_gt_batches2(const VkSubmitInfo2 *submits, uint32_t count)
+{
+   if (!vkr_gt_on() || !count)
+      return NULL;
+   struct vkr_gt_batch *out = calloc(count, sizeof(*out));
+   if (!out)
+      return NULL;
+   for (uint32_t i = 0; i < count; i++) {
+      const VkSubmitInfo2 *s = &submits[i];
+      for (uint32_t j = 0; j < s->waitSemaphoreInfoCount; j++)
+         vkr_gt_sem(out[i].waits, sizeof(out[i].waits),
+                    VKR_GT_ID(s->pWaitSemaphoreInfos[j].semaphore),
+                    &s->pWaitSemaphoreInfos[j].value);
+      for (uint32_t j = 0; j < s->signalSemaphoreInfoCount; j++)
+         vkr_gt_sem(out[i].signals, sizeof(out[i].signals),
+                    VKR_GT_ID(s->pSignalSemaphoreInfos[j].semaphore),
+                    &s->pSignalSemaphoreInfos[j].value);
+      for (uint32_t j = 0; j < s->commandBufferInfoCount && j < ARRAY_SIZE(out[i].cbs); j++)
+         out[i].cbs[out[i].cb_count++] = VKR_GT_ID(s->pCommandBufferInfos[j].commandBuffer);
+   }
+   return out;
+}
+
+static uint64_t
+gt_descriptor_id(const VkWriteDescriptorSet *w, uint32_t j)
+{
+   switch (w->descriptorType) {
+   case VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER:
+   case VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE:
+   case VK_DESCRIPTOR_TYPE_STORAGE_IMAGE:
+   case VK_DESCRIPTOR_TYPE_INPUT_ATTACHMENT:
+      return w->pImageInfo ? VKR_GT_ID(w->pImageInfo[j].imageView) : 0;
+   case VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER:
+   case VK_DESCRIPTOR_TYPE_STORAGE_BUFFER:
+   case VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER_DYNAMIC:
+   case VK_DESCRIPTOR_TYPE_STORAGE_BUFFER_DYNAMIC:
+      return w->pBufferInfo ? VKR_GT_ID(w->pBufferInfo[j].buffer) : 0;
+   case VK_DESCRIPTOR_TYPE_UNIFORM_TEXEL_BUFFER:
+   case VK_DESCRIPTOR_TYPE_STORAGE_TEXEL_BUFFER:
+      return w->pTexelBufferView ? VKR_GT_ID(w->pTexelBufferView[j]) : 0;
+   default:
+      return 0;
+   }
+}
+
+void
+vkr_gt_descriptor_writes(uint64_t cb, uint32_t count, const VkWriteDescriptorSet *writes)
+{
+   if (!vkr_gt_on())
+      return;
+   for (uint32_t i = 0; i < count; i++) {
+      const VkWriteDescriptorSet *w = &writes[i];
+      if (w->descriptorType == VK_DESCRIPTOR_TYPE_INLINE_UNIFORM_BLOCK)
+         continue;
+      for (uint32_t j = 0; j < w->descriptorCount; j++) {
+         const uint64_t id = gt_descriptor_id(w, j);
+         if (cb)
+            vkr_gt_link(cb, id, VKR_GT_DESCRIPTOR);
+         else
+            vkr_gt_slot(VKR_GT_ID(w->dstSet), (w->dstBinding << 12) | (w->dstArrayElement + j),
+                        id);
+      }
+   }
+}
+
+void
+vkr_gt_descriptor_copies(uint32_t count, const VkCopyDescriptorSet *copies)
+{
+   if (!vkr_gt_on())
+      return;
+   for (uint32_t i = 0; i < count; i++) {
+      const VkCopyDescriptorSet *c = &copies[i];
+      vkr_gt_copy_slots(VKR_GT_ID(c->srcSet), (c->srcBinding << 12) | c->srcArrayElement,
+                        VKR_GT_ID(c->dstSet), (c->dstBinding << 12) | c->dstArrayElement,
+                        c->descriptorCount);
+   }
+}
diff --git a/src/venus/vkr_gputrace.h b/src/venus/vkr_gputrace.h
new file mode 100644
index 0000000..9372780
--- /dev/null
+++ b/src/venus/vkr_gputrace.h
@@ -0,0 +1,110 @@
+/*
+ * Diagnostics only (vmlab card #237, guest/win3d/docs/tearing.md): with
+ * VMLAB_HV_GPU_TRACE=<dir> in its environment, a render worker writes every
+ * vkQueueSubmit and vkQueueSubmit2 of its context into
+ * <dir>/gpu-trace-<pid>.txt, the trace file format of vmlab-hv's GPU trace:
+ *
+ *    <CLOCK_MONOTONIC ns> vk_submit ctx=.. name=.. seq=.. queue=.. ...
+ *    <CLOCK_MONOTONIC ns> vk_done ctx=.. seq=.. queue=..
+ *
+ * vk_submit is written when the ring thread has handed the submission to the
+ * host driver; vk_done when an empty submission with a fence of the trace,
+ * made on the same queue right after it, signals: the host GPU has finished
+ * the submission's work by then.
+ */
+#ifndef VKR_GPUTRACE_H
+#define VKR_GPUTRACE_H
+
+#include "vkr_common.h"
+
+struct vkr_queue;
+
+/* Resource flags of an object a command buffer uses. */
+#define VKR_GT_WRITE 1u      /* attachment, copy or clear destination */
+#define VKR_GT_READ 2u       /* copy source */
+#define VKR_GT_DESCRIPTOR 4u /* through a bound or pushed descriptor */
+#define VKR_GT_BARRIER 8u    /* named by a pipeline barrier */
+
+bool
+vkr_gt_on(void);
+
+/* The guest id of a handle that the decoder has not replaced yet (it points
+ * at the vkr_object), 0 for VK_NULL_HANDLE. */
+static inline uint64_t
+vkr_gt_id_of(const void *handle)
+{
+   return handle ? ((const struct vkr_object *)handle)->id : 0;
+}
+#define VKR_GT_ID(handle) vkr_gt_id_of((const void *)(uintptr_t)(handle))
+
+/* The virgl resource behind a VkDeviceMemory. */
+void
+vkr_gt_set_res(uint64_t mem, uint32_t res_id);
+
+/* `parent` uses `child` (image -> memory, view -> image, command buffer ->
+ * image); flags 0 means the flags of the edge that reached the parent. */
+void
+vkr_gt_link(uint64_t parent, uint64_t child, uint32_t flags);
+
+/* A descriptor of a set: replaces what the slot held. */
+void
+vkr_gt_slot(uint64_t set, uint32_t slot, uint64_t child);
+
+/* Copy `count` slots of a set into another. */
+void
+vkr_gt_copy_slots(uint64_t src, uint32_t src_slot, uint64_t dst, uint32_t dst_slot,
+                  uint32_t count);
