// vmlab's website, authored in wdoc and rendered by the `wcl` CLI.
//
//   wcl wdoc serve docs/main.wcl                       # / = landing
//   wcl wdoc build docs/main.wcl --out docs/_site
//     → docs/_site/index.html                          vmlab landing (website template)
//   wcl wdoc build docs/manual/main.wcl --out docs/_site/manual
//     → docs/_site/manual/…                            the vmlab manual (book template)
//
// The landing and the manual are two documents, built into one tree by two
// invocations (`just docs-build` runs both). They are not one document on
// purpose: a multi-site document requires every page to name its `sites`,
// so folding the manual in here would make every chapter carry
// `sites = [:manual]` and stop the manual building on its own. Instead the
// manual keeps its own entry, and every link to it from the landing is the
// hand-written `./manual/` — the mount point, which a build tree never knows.
//
// The single `import <wdoc.wcl>` pulls in the embedded wdoc standard library, so
// every stdlib block (page / h1..h6 / p / code / callout / table / column / …) is
// in scope here and in every imported page.
import <wdoc.wcl>

// The vmlab landing: the `website` template (sticky header + banner/footer
// slots + theme toggle), its content authored from the landing components in
// pages/vmlab/landing-parts.wcl. One document, one site, so it renders at
// the output root without `root`.
site vmlab {
  default_template = :website
  title            = "vmlab"
  theme            = :nord
  accent           = :cyan
  theme_toggle     = true
  // Flat anchor menu (the single landing page carries every section);
  // dropdown menus are a `webpage`-template feature, so keep it flat.
  // `Reference` leaves the document, so it is a plain relative href.
  menu {
    item "Features"        { href = "#features" }
    item "Reference"       { href = "./manual/" }
    item "Getting started" { href = "#start" }
    item "Source"          { href = "https://github.com/VMLabDev/vmlab" }
  }
}

// vmlab landing page (sites = [:vmlab]), built from the landing components
// (imported first so the `lp_*` block kinds are in scope when index.wcl uses them).
import "./pages/vmlab/landing-parts.wcl"
import "./pages/vmlab/index.wcl"
