[Version]
Signature="$Windows NT$"
Class=Display
ClassGUID={4D36E968-E325-11CE-BFC1-08002BE10318}
ClassVer=2.0
Provider=%Vendor%
CatalogFile=vmlab-display.cat
DriverVer=11/04/2026,1.0.0.1
PnpLockDown=1

[Manufacturer]
%Vendor%=Models,NTamd64.10.0...22000

[Models.NTamd64.10.0...22000]
%Name%=Install,Root\VMLABDISPLAY

[SourceDisksFiles]
vmlab-display.dll=1

[SourceDisksNames]
1=%Disk%

[Install.NT]
Include=WUDFRD.inf
Needs=WUDFRD.NT
CopyFiles=DriverCopy

[Install.NT.HW]
Include=WUDFRD.inf
Needs=WUDFRD.NT.HW
AddReg=Settings

[Settings]
HKR,,UpperFilters,0x00010000,"IndirectKmd"
HKR,WUDF,DeviceGroupId,0x00000000,"VMLabDisplay"

[Install.NT.Services]
Include=WUDFRD.inf
Needs=WUDFRD.NT.Services

[Install.NT.Wdf]
UmdfService=VMLabDisplay,Service
UmdfServiceOrder=VMLabDisplay
UmdfKernelModeClientPolicy=AllowKernelModeClients
UmdfHostProcessSharing=ProcessSharingDisabled

[Service]
UmdfLibraryVersion=2.27.0
ServiceBinary=%12%\UMDF\vmlab-display.dll
UmdfExtensions=IddCx0102

[DestinationDirs]
DriverCopy=12,UMDF

[DriverCopy]
vmlab-display.dll

[Strings]
Vendor="VMLab"
Name="VMLab shared-memory display"
Disk="VMLab display driver"
