GenFw stores its absolute ELF input path in each PE CodeView record. The
temporary edk2 build directory changes on every run, including inside the
e2e image. Keep the module basename and size the record from that same name.

--- a/BaseTools/Source/C/GenFw/Elf64Convert.c
+++ b/BaseTools/Source/C/GenFw/Elf64Convert.c
@@ -841,6 +841,18 @@
 // Elf functions interface implementation
 //
 
+STATIC
+CONST CHAR8 *
+DebugImageName64 (
+  VOID
+  )
+{
+  CONST CHAR8 *Name;
+
+  Name = strrchr (mInImageName, '/');
+  return Name == NULL ? mInImageName : Name + 1;
+}
+
 STATIC
 VOID
 ScanSections64 (
@@ -1018,7 +1030,7 @@
   }
   mCoffOffset = mDebugOffset + sizeof(EFI_IMAGE_DEBUG_DIRECTORY_ENTRY) +
                 sizeof(EFI_IMAGE_DEBUG_CODEVIEW_NB10_ENTRY) +
-                strlen(mInImageName) + 1;
+                strlen(DebugImageName64()) + 1;
 
   //
   // Add more space in the .debug data region for the DllCharacteristicsEx
@@ -2451,7 +2463,7 @@
   EFI_IMAGE_DEBUG_CODEVIEW_NB10_ENTRY         *Nb10;
   EFI_IMAGE_DEBUG_EX_DLLCHARACTERISTICS_ENTRY *DllEntry;
 
-  Len = strlen(mInImageName) + 1;
+  Len = strlen(DebugImageName64()) + 1;
 
   NtHdr = (EFI_IMAGE_OPTIONAL_HEADER_UNION *)(mCoffFile + mNtHdrOffset);
   DataDir = &NtHdr->Pe32Plus.OptionalHeader.DataDirectory[EFI_IMAGE_DIRECTORY_ENTRY_DEBUG];
@@ -2484,7 +2496,7 @@
 
   Nb10 = (EFI_IMAGE_DEBUG_CODEVIEW_NB10_ENTRY*)(Dir + 1);
   Nb10->Signature = CODEVIEW_SIGNATURE_NB10;
-  strcpy ((char *)(Nb10 + 1), mInImageName);
+  strcpy ((char *)(Nb10 + 1), DebugImageName64());
 }
 
 STATIC
