Subject: Pin the iSCSI default-value array size

The DEC default is "yes" (four bytes including NUL), while this override is
"no" (three bytes). Inferred maximum sizes can retain the DEC default's size
depending on AutoGen processing order. Set the maximum explicitly without
changing the runtime value or network-boot policy.

--- a/OvmfPkg/Include/Dsc/NetworkComponents.dsc.inc
+++ b/OvmfPkg/Include/Dsc/NetworkComponents.dsc.inc
@@ -49,7 +49,7 @@
       <PcdsFixedAtBuild>
         gUefiOvmfPkgTokenSpaceGuid.PcdEntryPointOverrideFwCfgVarName|"opt/org.tianocore/ISCSISupport"
         !if $(NETWORK_ISCSI_DEFAULT_ENABLE) == FALSE
-          gUefiOvmfPkgTokenSpaceGuid.PcdEntryPointOverrideDefaultValue|"no"
+          gUefiOvmfPkgTokenSpaceGuid.PcdEntryPointOverrideDefaultValue|"no"|VOID*|4
         !endif
     }
   !endif
