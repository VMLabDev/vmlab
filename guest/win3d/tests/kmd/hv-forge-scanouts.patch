 /// QEMU's default monitor, captured through the Ubuntu guest's DRM connector.
+/// TEST ONLY (guest/win3d/tests/kmd): the scanout count this device reports,
+/// from `VMLAB_HV_FORGE_SCANOUTS`. It still has one scanout.
+fn forged_scanouts() -> u32 {
+    static COUNT: std::sync::OnceLock<u32> = std::sync::OnceLock::new();
+    *COUNT.get_or_init(|| {
+        let count = std::env::var("VMLAB_HV_FORGE_SCANOUTS")
+            .ok()
+            .and_then(|v| v.parse().ok())
+            .unwrap_or(1);
+        log::warn!("forged host: virtio-gpu reports num_scanouts = {count}");
+        count
+    })
+}
