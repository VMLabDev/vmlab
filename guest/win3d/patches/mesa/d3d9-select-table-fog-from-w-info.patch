Subject: [PATCH] d3d9: select table fog from the runtime W range

UpdateWInfo reports (1, 1) for Z fog. A projection with constant
non-unit W can report equal endpoints and still requires W fog. In
that case the pixel shader already recovers W from the reciprocal
clip W supplied by the rasterizer, including for POSITIONT draws.

Keep the projection fallback for draws before the first UpdateWInfo.
---
diff --git a/src/gallium/frontends/d3d10umd/D3D9Draw.cpp b/src/gallium/frontends/d3d10umd/D3D9Draw.cpp
--- a/src/gallium/frontends/d3d10umd/D3D9Draw.cpp
+++ b/src/gallium/frontends/d3d10umd/D3D9Draw.cpp
@@ -69,21 +69,18 @@ struct D3D9AutoUploadResources
    }
 };
 
 /*
- * Table fog uses eye-space depth (w) when the projection is perspective and
- * screen z otherwise.  When the runtime emulates fixed-function vertex
- * processing with shaders it never calls SetTransform, so the projection
- * the UMD holds stays the identity.  The runtime still reports the w range
- * of the projection through UpdateWInfo, and sends WNear == WFar (1.0) for a
- * projection that is not perspective.
+ * The runtime reports the projection's W range through UpdateWInfo, even
+ * when it handles the transforms itself.  Only (1, 1) selects screen Z.
+ * A constant non-unit W yields equal endpoints and still selects W fog.
  */
 static bool
 D3D9ProjectionUsesZFog(const D3D9Device *device)
 {
-   const D3DMATRIX &projection = device->transforms[D3DTS_PROJECTION];
+   if (device->has_winfo)
+      return device->winfo.WNear == 1.0f && device->winfo.WFar == 1.0f;
 
-   if (device->winfo.WNear != device->winfo.WFar)
-      return false;
+   const D3DMATRIX &projection = device->transforms[D3DTS_PROJECTION];
    return projection._34 == 0.0f && projection._44 == 1.0f;
 }
 
diff --git a/src/gallium/frontends/d3d10umd/D3D9Private.h b/src/gallium/frontends/d3d10umd/D3D9Private.h
--- a/src/gallium/frontends/d3d10umd/D3D9Private.h
+++ b/src/gallium/frontends/d3d10umd/D3D9Private.h
@@ -93,6 +93,7 @@
    D3DDDIARG_VIEWPORTINFO viewport;
    D3DDDIARG_ZRANGE zrange;
    D3DDDIARG_WINFO winfo;
+   bool has_winfo;
    RECT scissor_rect;
    D3DDDIARG_SETMATERIAL material;
    FLOAT clip_planes[D3D9_MAX_USER_CLIP_PLANES][4];
diff --git a/src/gallium/frontends/d3d10umd/D3D9State.cpp b/src/gallium/frontends/d3d10umd/D3D9State.cpp
--- a/src/gallium/frontends/d3d10umd/D3D9State.cpp
+++ b/src/gallium/frontends/d3d10umd/D3D9State.cpp
@@ -415,5 +415,6 @@ D3D9UpdateWInfo(HANDLE hDevice, const D3DDDIARG_WINFO *data)
    if (!device || !data)
       return E_INVALIDARG;
    device->winfo = *data;
+   device->has_winfo = true;
    return S_OK;
 }
