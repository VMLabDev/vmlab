+/* Undo the period added by the geometry shader before shader arithmetic. */
+static struct ureg_src
+tx_wrap_texcoord(struct shader_translator *tx, struct ureg_src input,
+                 unsigned index)
+{
+    const unsigned mask = (tx->info->coordinate_wrap >> (4 * index)) & 0xf;
+    if (!mask)
+        return input;
+
+    struct ureg_program *ureg = tx->ureg;
+    const struct ureg_dst result = ureg_DECL_temporary(ureg);
+    const struct ureg_dst adjusted = ureg_DECL_temporary(ureg);
+    const struct ureg_dst test = ureg_DECL_temporary(ureg);
+    const struct ureg_src one = ureg_imm1f(ureg, 1.0f);
+    ureg_MOV(ureg, result, input);
+    ureg_FSLT(ureg, test, one, input);
+    ureg_ADD(ureg, adjusted, input, ureg_negate(one));
+    ureg_UCMP(ureg, ureg_writemask(result, mask),
+              ureg_src(test), ureg_src(adjusted), input);
+    ureg_release_temporary(ureg, test);
+    ureg_release_temporary(ureg, adjusted);
+    return ureg_src(result);
+}
