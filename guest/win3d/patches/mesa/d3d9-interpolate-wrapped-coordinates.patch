+/* Move the seam into the largest gap, then lift the vertices below it by
+ * one period. The rasterizer still performs clipping and perspective
+ * interpolation on the adjusted coordinates. */
+static void *
+D3D9CreateWrapGs(D3D9Device *device, enum mesa_prim mode,
+                 const struct tgsi_shader_info &vs, uint64_t wrap,
+                 bool &needs_gs)
+{
+   if (!wrap || mode == MESA_PRIM_POINTS)
+      return NULL;
+
+   const bool lines = mode == MESA_PRIM_LINES || mode == MESA_PRIM_LINE_STRIP;
+   const unsigned vertices = lines ? 2 : 3;
+   unsigned masks[PIPE_MAX_SHADER_OUTPUTS] = {};
+   for (unsigned i = 0; i < vs.num_outputs; ++i) {
+      for (unsigned t = 0; t < 16; ++t) {
+         const bool texcoord = device->screen->caps.tgsi_texcoord && t < 8;
+         const auto semantic = texcoord ? TGSI_SEMANTIC_TEXCOORD : TGSI_SEMANTIC_GENERIC;
+         if (vs.output_semantic_name[i] == semantic &&
+             vs.output_semantic_index[i] ==
+                nine_texcoord_semantic_index(t, device->screen->caps.tgsi_texcoord))
+            masks[i] = ((wrap >> (4 * t)) & 0xf) & vs.output_usagemask[i];
+      }
+      needs_gs |= masks[i] != 0;
+   }
+   if (!needs_gs)
+      return NULL;
+
+   struct ureg_program *ureg = ureg_create(MESA_SHADER_GEOMETRY);
+   if (!ureg)
+      return NULL;
+   ureg_property(ureg, TGSI_PROPERTY_GS_INPUT_PRIM,
+                 lines ? MESA_PRIM_LINES : MESA_PRIM_TRIANGLES);
+   ureg_property(ureg, TGSI_PROPERTY_GS_OUTPUT_PRIM,
+                 lines ? MESA_PRIM_LINE_STRIP : MESA_PRIM_TRIANGLE_STRIP);
+   ureg_property(ureg, TGSI_PROPERTY_GS_MAX_OUTPUT_VERTICES, vertices);
+   ureg_property(ureg, TGSI_PROPERTY_GS_INVOCATIONS, 1);
+
+   struct ureg_src inputs[PIPE_MAX_SHADER_OUTPUTS];
+   struct ureg_dst outputs[PIPE_MAX_SHADER_OUTPUTS];
+   struct ureg_dst seams[PIPE_MAX_SHADER_OUTPUTS];
+   const struct ureg_src one = ureg_imm1f(ureg, 1.0f);
+   const struct ureg_src zero = ureg_imm1f(ureg, 0.0f);
+   const struct ureg_dst low = ureg_DECL_temporary(ureg);
+   const struct ureg_dst high = ureg_DECL_temporary(ureg);
+   const struct ureg_dst middle = ureg_DECL_temporary(ureg);
+   const struct ureg_dst gap_low = ureg_DECL_temporary(ureg);
+   const struct ureg_dst gap_high = ureg_DECL_temporary(ureg);
+   const struct ureg_dst gap_wrap = ureg_DECL_temporary(ureg);
+   const struct ureg_dst tmp = ureg_DECL_temporary(ureg);
+
+   for (unsigned i = 0; i < vs.num_outputs; ++i) {
+      const auto semantic = (enum tgsi_semantic)vs.output_semantic_name[i];
+      const unsigned index = vs.output_semantic_index[i];
+      inputs[i] = ureg_DECL_input(ureg, semantic, index, 0, 1);
+      outputs[i] = ureg_DECL_output_masked(ureg, semantic, index,
+                                           vs.output_usagemask[i], 0, 1);
+      if (!masks[i])
+         continue;
+
+      seams[i] = ureg_DECL_temporary(ureg);
+      const auto seam = ureg_writemask(seams[i], masks[i]);
+      const auto a = ureg_src_dimension(inputs[i], 0);
+      const auto b = ureg_src_dimension(inputs[i], 1);
+      ureg_MIN(ureg, low, a, b);
+      ureg_MAX(ureg, high, a, b);
+      if (vertices == 3) {
+         const auto c = ureg_src_dimension(inputs[i], 2);
+         ureg_MIN(ureg, middle, ureg_src(high), c);
+         ureg_MAX(ureg, middle, ureg_src(low), ureg_src(middle));
+         ureg_MIN(ureg, low, ureg_src(low), c);
+         ureg_MAX(ureg, high, ureg_src(high), c);
+      } else {
+         ureg_MOV(ureg, middle, ureg_src(high));
+      }
+      ureg_ADD(ureg, gap_low, ureg_src(middle), ureg_negate(ureg_src(low)));
+      ureg_ADD(ureg, gap_high, ureg_src(high), ureg_negate(ureg_src(middle)));
+      ureg_ADD(ureg, gap_wrap, one, ureg_src(low));
+      ureg_ADD(ureg, gap_wrap, ureg_src(gap_wrap), ureg_negate(ureg_src(high)));
+      ureg_FSGE(ureg, tmp, ureg_src(gap_low), ureg_src(gap_high));
+      ureg_UCMP(ureg, seam, ureg_src(tmp), ureg_src(middle), ureg_src(high));
+      ureg_MAX(ureg, gap_low, ureg_src(gap_low), ureg_src(gap_high));
+      ureg_FSGE(ureg, tmp, ureg_src(gap_wrap), ureg_src(gap_low));
+      ureg_UCMP(ureg, seam, ureg_src(tmp), zero, ureg_src(seam));
+   }
+
+   for (unsigned v = 0; v < vertices; ++v) {
+      for (unsigned i = 0; i < vs.num_outputs; ++i) {
+         const auto input = ureg_src_dimension(inputs[i], v);
+         ureg_MOV(ureg, outputs[i], input);
+         if (masks[i]) {
+            ureg_FSLT(ureg, tmp, input, ureg_src(seams[i]));
+            ureg_UCMP(ureg, tmp, ureg_src(tmp), one, zero);
+            ureg_ADD(ureg, ureg_writemask(outputs[i], masks[i]),
+                     input, ureg_src(tmp));
+         }
+      }
+      ureg_EMIT(ureg, ureg_imm1u(ureg, 0));
+   }
+   ureg_ENDPRIM(ureg, ureg_imm1u(ureg, 0));
+   ureg_END(ureg);
+   return ureg_create_shader_and_destroy(ureg, device->pipe);
+}
