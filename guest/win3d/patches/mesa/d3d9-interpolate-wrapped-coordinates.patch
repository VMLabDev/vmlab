+/* The DDI keeps WRAP8 through WRAP15 in a second range. */
+static inline uint64_t
+D3D9CoordinateWrapMask(const D3D9Device *device)
+{
+   uint64_t wrap = 0;
+   for (unsigned i = 0; i < 8; ++i) {
+      wrap |= (uint64_t)(device->render_states[D3DDDIRS_WRAP0 + i] & 0xf) << (4 * i);
+      wrap |= (uint64_t)(device->render_states[D3DDDIRS_WRAP8 + i] & 0xf) << (4 * (i + 8));
+   }
+   return wrap;
+}
