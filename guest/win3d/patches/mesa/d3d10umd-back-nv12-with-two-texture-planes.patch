+
+static void
+CopyNV12(struct pipe_context *pipe, Resource *dst, unsigned x, unsigned y,
+         unsigned layer, Resource *src, const struct pipe_box &box)
+{
+   if (!dst->nv12_chroma || !src->nv12_chroma || !NV12BoxAligned(box) ||
+       ((x | y) & 1) || box.width <= 0 || box.height <= 0 || box.depth != 1)
+      return;
