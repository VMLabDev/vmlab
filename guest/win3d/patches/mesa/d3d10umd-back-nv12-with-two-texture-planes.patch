+/* D3D11 selects an NV12 plane through the typed view format. */
+static inline struct pipe_resource *
+ViewPipeResource(Resource *resource, DXGI_FORMAT format)
+{
+   if (!resource || resource->Format != DXGI_FORMAT_NV12)
+      return resource ? resource->resource : NULL;
+
+   switch (format) {
+   case DXGI_FORMAT_R8_UINT:
+   case DXGI_FORMAT_R8_UNORM:
+      return resource->resource;
+   case DXGI_FORMAT_R8G8_UINT:
+   case DXGI_FORMAT_R8G8_UNORM:
+      return resource->nv12_chroma;
+   default:
+      return NULL;
+   }
+}
 
