+      return DXGI_DDI_ERR_UNSUPPORTED;
+   resource->resource = screen->resource_create(screen, &plane);
+   if (!resource->resource)
+      return E_OUTOFMEMORY;
+
+   plane.width0 /= 2;
+   plane.height0 /= 2;
+   plane.format = PIPE_FORMAT_R8G8_UINT;
+   if (is_resource_format_supported(screen, &plane))
