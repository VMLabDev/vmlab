+         }
+         for (int y = 0; y < boxes[plane].height; ++y) {
+            memcpy(output, input + size_t(y) * transfer->stride, pitch);
+            output += pitch;
+         }
+         pipe_texture_unmap(pipe, transfer);
+      }
+   }
+
+   resource->nv12_maps[subresource] = {data, bool(usage & PIPE_MAP_WRITE)};
+   mapped->pData = data;
+   mapped->RowPitch = pitch;
+   mapped->DepthPitch = static_cast<UINT>(size);
+   return S_OK;
+}
 
