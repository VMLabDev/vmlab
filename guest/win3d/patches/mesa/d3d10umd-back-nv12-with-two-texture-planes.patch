+   const struct pipe_box chroma = NV12ChromaBox(box);
+   pipe->resource_copy_region(pipe, dst->resource, 0, x, y, layer,
+                              src->resource, 0, &box);
+   pipe->resource_copy_region(pipe, dst->nv12_chroma, 0, x / 2, y / 2, layer,
+                              src->nv12_chroma, 0, &chroma);
+}
