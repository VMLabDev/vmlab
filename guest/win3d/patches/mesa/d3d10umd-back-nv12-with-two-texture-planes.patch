+   const uint8_t *uv = static_cast<const uint8_t *>(data) + size_t(pitch) * box.height;
+   pipe->texture_subdata(pipe, resource->resource, 0, 0, &box, data, pitch, 0);
+   pipe->texture_subdata(pipe, resource->nv12_chroma, 0, 0, &chroma, uv, pitch, 0);
