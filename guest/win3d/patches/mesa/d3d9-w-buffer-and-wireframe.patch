@@ -261,3 +261,4 @@
    void *translated_ps_cso;
    UINT translated_ps_key;
+   bool translated_ps_w_depth;
    uint64_t translated_ps_sampler_type_overrides;
diff --git a/src/gallium/frontends/d3d10umd/D3D9ShaderTranslate.h b/src/gallium/frontends/d3d10umd/D3D9ShaderTranslate.h
--- a/src/gallium/frontends/d3d10umd/D3D9ShaderTranslate.h
+++ b/src/gallium/frontends/d3d10umd/D3D9ShaderTranslate.h
@@ -23,4 +23,5 @@
                                          UINT fog_mode,
-                                         bool zfog,
-                                         uint8_t projected,
+                                         bool zfog,
+                                         bool w_depth,
+                                         uint8_t projected,
                                          uint32_t sampler_ps1xtypes,
diff --git a/src/gallium/frontends/d3d10umd/D3D9ShaderTranslate.cpp b/src/gallium/frontends/d3d10umd/D3D9ShaderTranslate.cpp
--- a/src/gallium/frontends/d3d10umd/D3D9ShaderTranslate.cpp
+++ b/src/gallium/frontends/d3d10umd/D3D9ShaderTranslate.cpp
@@ -119,4 +119,4 @@
 D3D9TranslatePixelShaderForState(D3D9Device *device, D3D9Object *shader,
-                                 bool fog_enable, UINT fog_mode, bool zfog,
-                                 uint8_t projected,
+                                 bool fog_enable, UINT fog_mode, bool zfog,
+                                 bool w_depth, uint8_t projected,
                                  uint32_t sampler_ps1xtypes,
@@ -150,3 +150,4 @@
    info.fog_mode = fog_enable ? (uint8_t)fog_mode : D3DFOG_NONE;
-   info.zfog = zfog ? 1 : 0;
+   info.zfog = zfog ? 1 : 0;
+   info.w_depth = w_depth;
    info.projected = projected;
@@ -179,3 +180,4 @@
       (info.color_flatshade ? 1u << 12 : 0u) |
       (sampler_ps1xtypes << 13);
+   shader->translated_ps_w_depth = w_depth;
    shader->translated_ps_sampler_type_overrides = sampler_type_overrides;
@@ -207,3 +209,3 @@
    return D3D9TranslatePixelShaderForState(device, shader, false,
-                                          D3DFOG_NONE, true, 0, 0, 0, 0, 0,
+                                          D3DFOG_NONE, true, false, 0, 0, 0, 0, 0,
                                           0, 0);
