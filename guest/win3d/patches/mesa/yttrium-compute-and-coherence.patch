    if (!pDevice || !pDevice->pipe || !args || !args->resource)
       return;
 
+   Shader *cs = pDevice->bound_cs;
+   if (!cs)
+      return;
+   if (cs->compute_emulation == COMPUTE_EMULATION_NONE && cs->handle) {
+      if (args->resource->target != PIPE_BUFFER ||
+          (AlignedByteOffsetForArgs & 3) ||
+          AlignedByteOffsetForArgs > args->resource->width0 ||
+          sizeof(dispatch_args) > args->resource->width0 - AlignedByteOffsetForArgs)
+         return;
+      struct pipe_grid_info info = {};
+      info.work_dim = 3;
+      info.indirect = args->resource;
+      info.indirect_offset = AlignedByteOffsetForArgs;
+      for (unsigned i = 0; i < 3; i++)
+         info.block[i] = cs->thread_group_size[i] ? cs->thread_group_size[i] : 1;
+      pDevice->pipe->launch_grid(pDevice->pipe, &info);
+      return;
+   }
+
    if (!ReadBufferRange(pDevice->pipe, args->resource,
                         AlignedByteOffsetForArgs, sizeof(dispatch_args),
                         dispatch_args))
