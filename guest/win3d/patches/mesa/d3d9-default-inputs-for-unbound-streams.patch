Subject: [PATCH] d3d9: supply default vertex inputs for unbound streams

A declaration may name a stream with no source bound. Feed the existing
zero input to shaders that read those elements, just as for shader inputs
missing from the declaration. This lets the runtime fixed-function vertex
shader use the bound diffuse and specular inputs alongside zero values
and gives programmable vertex shaders the same default.

diff --git a/src/gallium/frontends/d3d10umd/D3D9Draw.cpp b/src/gallium/frontends/d3d10umd/D3D9Draw.cpp
--- a/src/gallium/frontends/d3d10umd/D3D9Draw.cpp
+++ b/src/gallium/frontends/d3d10umd/D3D9Draw.cpp
@@ -1315,7 +1315,13 @@ D3D9FillTranslatedVsVertexElements(const D3D9Device *device,
          }
       }
 
-      if (!element) {
+      if (element && (element->Stream >= ARRAYSIZE(device->streams) ||
+                      element->Method != D3DDECLMETHOD_DEFAULT))
+         return 0;
+
+      if (!element ||
+          (!device->streams[element->Stream].sysmem &&
+           !device->streams[element->Stream].vertex_buffer)) {
          memset(&elements[input], 0, sizeof(elements[input]));
          elements[input].vertex_buffer_index = D3D9_DEFAULT_VERTEX_INPUT_BUFFER;
          elements[input].src_format = PIPE_FORMAT_R32G32B32A32_FLOAT;
@@ -1325,10 +1331,6 @@ D3D9FillTranslatedVsVertexElements(const D3D9Device *device,
          continue;
       }
 
-      if (element->Stream >= ARRAYSIZE(device->streams) ||
-          element->Method != D3DDECLMETHOD_DEFAULT)
-         return 0;
-
       const enum pipe_format format = D3D9DeclTypeToPipeFormat(element->Type);
       if (format == PIPE_FORMAT_NONE)
          return 0;
