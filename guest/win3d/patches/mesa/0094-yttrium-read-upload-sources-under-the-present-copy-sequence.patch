From: vmlab-win3d
Subject: [PATCH] yttrium: read upload sources again when a present copy ran across the read

The compositor composes a window that presents with a Blt (windowed Direct3D
9, WPF, blt-model DXGI) from the present's destination: guest memory that the
KMD writes on a guest CPU, sub-rectangle by sub-rectangle and row by row. It
hands that memory to UpdateSubresourceUP, and the copy into the upload
staging buffer in yttrium_copy_cpu_to_venus_image is the read. Nothing orders
that read against the KMD's copy. When they overlap, the staging buffer holds
rows of two frames and the console shows a band of the earlier frame until
the next present (card #134, docs/tearing.md). At 90 percent host load the
trace build measured 3 of 369 copies stretched past 1 ms by a preempted vCPU,
and the tearing probe counted 3 torn compositions in 20,000 frames on the AMD
host.

The KMD now numbers its copies (patches/kmd/0006): the sequence is odd while
one writes. The read of a caller's memory takes the sequence before and
after, and repeats while it is odd or changed, for at most 100 ms. An older
KMD has no such escape: the first failure turns the check off for the
process.
---
diff --git a/src/gallium/frontends/d3d10umd/D3DKMT.cpp b/src/gallium/frontends/d3d10umd/D3DKMT.cpp
index c2361ec..f823d21 100644
--- a/src/gallium/frontends/d3d10umd/D3DKMT.cpp
+++ b/src/gallium/frontends/d3d10umd/D3DKMT.cpp
@@ -90,6 +90,7 @@ D3DKMTIsKnownViogpuEscapeType(USHORT type)
    case VIOGPU_RES_CREATE_BLOB:
    case VIOGPU_RES_SET_SCANOUT_BLOB:
    case VIOGPU_RES_ATTACH_WAIT:
+   case VIOGPU_CPU_COPY_SEQUENCE:
    case VIOGPU_CTX_INIT:
    case VIOGPU_SUBMIT_CMD:
       return true;
diff --git a/src/gallium/frontends/d3d10umd/gdikmt_d3dddi.cpp b/src/gallium/frontends/d3d10umd/gdikmt_d3dddi.cpp
index d939664..ea98998 100644
--- a/src/gallium/frontends/d3d10umd/gdikmt_d3dddi.cpp
+++ b/src/gallium/frontends/d3d10umd/gdikmt_d3dddi.cpp
@@ -232,6 +232,7 @@ gdikmt_is_known_viogpu_escape_type(USHORT type)
    case VIOGPU_RES_CREATE_BLOB:
    case VIOGPU_RES_SET_SCANOUT_BLOB:
    case VIOGPU_RES_ATTACH_WAIT:
+   case VIOGPU_CPU_COPY_SEQUENCE:
    case VIOGPU_CHECK_DIRECT_FLIP:
    case VIOGPU_CTX_INIT:
    case VIOGPU_SUBMIT_CMD:
diff --git a/src/gallium/winsys/yttrium/gdi/yttrium_internal.h b/src/gallium/winsys/yttrium/gdi/yttrium_internal.h
index 05a0456..0318939 100644
--- a/src/gallium/winsys/yttrium/gdi/yttrium_internal.h
+++ b/src/gallium/winsys/yttrium/gdi/yttrium_internal.h
@@ -334,6 +334,10 @@ struct yttrium_resource {
    uint64_t data_capacity;
    bool owns_data;
    bool data_dirty;
+   /* `data` is memory of the caller of UpdateSubresourceUP. The compositor
+    * passes the destination of a Blt present, which the KMD writes on a guest
+    * CPU with no regard for readers: read it under the copy sequence. */
+   bool cpu_copy_guarded;
    /* GPU writes make GPU storage authoritative. CPU consumers, including
     * constant collection, must map the resource before reading its backing. */
    bool gpu_buffer_written;
diff --git a/src/gallium/winsys/yttrium/gdi/yttrium_resource.c b/src/gallium/winsys/yttrium/gdi/yttrium_resource.c
index 0bb6479..d4e612a 100644
--- a/src/gallium/winsys/yttrium/gdi/yttrium_resource.c
+++ b/src/gallium/winsys/yttrium/gdi/yttrium_resource.c
@@ -3474,6 +3474,7 @@ yttrium_texture_subdata(struct pipe_context *ctx,
       src.base.array_size = box->depth;
       src.base.last_level = 0;
       src.data = (void *)data;
+      src.cpu_copy_guarded = true;
       src.stride = stride;
       src.layer_stride = (unsigned)layer_stride;
       if (!src.layer_stride)
@@ -3765,6 +3766,31 @@ yttrium_clear(struct pipe_context *ctx, unsigned buffers,
 {
 }
 
+#define YTTRIUM_CPU_COPY_GUARD_NS (100 * 1000 * 1000ll)
+
+/* The KMD's sequence number of Blt present copies: odd while one writes. False
+ * when the KMD has no such escape (an older driver): nothing to compare. */
+static bool
+yttrium_cpu_copy_sequence(struct yttrium_screen *screen, uint32_t *sequence)
+{
+   static volatile LONG unsupported;
+
+   if (unsupported || !screen || !screen->device || !screen->device->escape)
+      return false;
+
+   VIOGPU_ESCAPE query;
+   memset(&query, 0, sizeof(query));
+   query.Type = VIOGPU_CPU_COPY_SEQUENCE;
+   query.DataLength = sizeof(UINT);
+   if (!NT_SUCCESS(screen->device->escape(screen->device, &query,
+                                          sizeof(query)))) {
+      InterlockedExchange(&unsupported, 1);
+      return false;
+   }
+   *sequence = query.Id;
+   return true;
+}
+
 bool
 yttrium_copy_cpu_to_venus_image(struct pipe_context *ctx,
                                 struct yttrium_resource *ysrc,
@@ -3874,14 +3900,39 @@ yttrium_copy_cpu_to_venus_image(struct pipe_context *ctx,
    uint8_t *dst_ptr =
       (uint8_t *)yctx->upload_staging_mapping.map + staging_offset;
 
-   for (uint32_t z = 0; z < depth; z++) {
-      for (uint32_t y = 0; y < rows; y++) {
-         memcpy(dst_ptr + (uint64_t)z * staging_layer_stride +
-                   (uint64_t)y * staging_stride,
-                src_ptr + (uint64_t)z * src_layer_stride +
-                   (uint64_t)y * src_stride,
-                row_bytes);
+   /* A windowed Direct3D 9 or blt-model present ends in the KMD as a copy on
+    * a guest CPU into guest memory, sub-rectangle by sub-rectangle and row by
+    * row. The compositor reads that memory whenever it composes and passes it
+    * here. A read that overlaps a copy takes rows of two frames, and the
+    * compositor then shows a frame with a band of the earlier one
+    * (docs/tearing.md). The reader cannot stop the copy and the copy cannot
+    * see the reader, so the read repeats until no copy ran across it. */
+   const int64_t guard_deadline =
+      os_time_get_nano() + YTTRIUM_CPU_COPY_GUARD_NS;
+   for (;;) {
+      uint32_t before = 0, after = 0;
+      const bool guarded = ysrc->cpu_copy_guarded &&
+                           yttrium_cpu_copy_sequence(screen, &before);
+
+      for (uint32_t z = 0; z < depth; z++) {
+         for (uint32_t y = 0; y < rows; y++) {
+            memcpy(dst_ptr + (uint64_t)z * staging_layer_stride +
+                      (uint64_t)y * staging_stride,
+                   src_ptr + (uint64_t)z * src_layer_stride +
+                      (uint64_t)y * src_stride,
+                   row_bytes);
+         }
       }
+      if (!guarded)
+         break;
+      if (!(before & 1) && yttrium_cpu_copy_sequence(screen, &after) &&
+          after == before)
+         break;
+      /* A copy that a host preempted in the middle can last milliseconds.
+       * Past the deadline the frame goes out as it is, as before. */
+      if (os_time_get_nano() > guard_deadline)
+         break;
+      SwitchToThread();
    }
    MemoryBarrier();
    yctx->upload_staging_offset =
diff --git a/src/virtio/wddm/viogpu_wddm_driver.h b/src/virtio/wddm/viogpu_wddm_driver.h
index 5df7ba5..cd68b97 100644
--- a/src/virtio/wddm/viogpu_wddm_driver.h
+++ b/src/virtio/wddm/viogpu_wddm_driver.h
@@ -74,6 +74,9 @@ typedef struct _VIOGPU_ADAPTERINFO {
 #define VIOGPU_RES_SET_SCANOUT_BLOB                       0x105
 #define VIOGPU_RES_ATTACH_WAIT                            0x106
 #define VIOGPU_CHECK_DIRECT_FLIP                          0x107
+/* vmlab: the sequence number of the KMD's CPU copy of Blt presents, in Id.
+ * Odd while a copy writes its destination. */
+#define VIOGPU_CPU_COPY_SEQUENCE                          0x1F0
 
 #define VIOGPU_CTX_INIT                                   0x200
 #define VIOGPU_SUBMIT_CMD                                 0x300
