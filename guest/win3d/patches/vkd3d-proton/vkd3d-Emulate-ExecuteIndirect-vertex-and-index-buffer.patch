diff --git a/libs/vkd3d/shaders/cs_execute_indirect_vertex_fetch.comp b/libs/vkd3d/shaders/cs_execute_indirect_vertex_fetch.comp
new file mode 100644
index 0000000..6715591
--- /dev/null
+++ b/libs/vkd3d/shaders/cs_execute_indirect_vertex_fetch.comp
@@ -0,0 +1,524 @@
+#version 450
+#extension GL_EXT_buffer_reference : require
+#extension GL_EXT_buffer_reference_uvec2 : require
+
+/* ExecuteIndirect emulation without EXT_dgc, for command signatures that set
+ * vertex or index buffer views. Vulkan binds those buffers by handle while
+ * recording, so a view the GPU reads from the argument buffer cannot be bound.
+ * Instead, the indices and the vertices each sequence uses are copied into
+ * scratch buffers that are bound for every sequence, and the draw arguments
+ * are rewritten to point there.
+ *
+ * One pipeline, four passes selected by mode:
+ *  LAYOUT_INDEX  one invocation. Gives each indexed sequence a range of the index scratch.
+ *  SCAN_INDEX    one invocation per index. Copies indices as 32-bit, and finds
+ *                the lowest and highest vertex each sequence uses.
+ *  LAYOUT_VERTEX one invocation. Gives each sequence a range of the vertex and
+ *                instance scratch, and writes its draw arguments.
+ *  COPY          one invocation per vertex or instance element. Copies the elements. */
+
+layout(local_size_x = 64) in;
+
+#define MODE_LAYOUT_INDEX 0u
+#define MODE_SCAN_INDEX 1u
+#define MODE_LAYOUT_VERTEX 2u
+#define MODE_COPY 3u
+
+#define FLAG_INDEXED 1u
+#define FLAG_RESTART 2u
+#define FLAG_COPY_VERTICES 4u
+#define FLAG_COPY_INSTANCES 8u
+
+#define BINDING_INSTANCE_RATE 1u
+
+#define NO_WORD 0xffffffffu
+#define DXGI_FORMAT_R32_UINT 42u
+
+struct Binding
+{
+	/* Word of the view in an argument record, or NO_WORD when the view is the constant below. */
+	uint src_word;
+	uint flags;
+	uvec2 va;
+	uint size;
+	uint stride;
+	uvec2 dst_va;
+	uint dst_stride;
+	uint reserved;
+};
+
+layout(buffer_reference, std430, buffer_reference_align = 8) readonly buffer Params
+{
+	uvec2 api_buffer_va;
+	uvec2 count_va;
+	uvec2 slots_va;
+	uvec2 state_va;
+	uvec2 index_scratch_va;
+	uvec2 totals_va;
+	uvec2 status_va;
+	uint api_stride_words;
+	uint slot_stride_words;
+	uint slot_action_word;
+	uint draw_src_word;
+	uint max_commands;
+	uint flags;
+	uint index_budget;
+	uint vertex_budget;
+	uint instance_budget;
+	/* The index buffer view, as for Binding. format is a DXGI_FORMAT. */
+	uint ibv_src_word;
+	uvec2 ib_va;
+	uint ib_size;
+	uint ib_format;
+	uint binding_count;
+	uint reserved;
+	Binding bindings[32];
+};
+
+struct Sequence
+{
+	uint index_first;
+	uint index_count;
+	uint vertex_min;
+	uint vertex_max;
+	uint vertex_first;
+	uint vertex_count;
+	uint instance_first;
+	uint instance_count;
+};
+
+layout(buffer_reference, std430, buffer_reference_align = 4) buffer SequenceState
+{
+	Sequence seq[];
+};
+
+layout(buffer_reference, std430, buffer_reference_align = 4) buffer Totals
+{
+	/* VkDispatchIndirectCommand of SCAN_INDEX, then the number of indices. */
+	uint index_dispatch_x, index_dispatch_y, index_dispatch_z;
+	uint index_total;
+	/* VkDispatchIndirectCommand of COPY, then the number of elements of each kind. */
+	uint copy_dispatch_x, copy_dispatch_y, copy_dispatch_z;
+	uint vertex_total;
+	uint instance_total;
+};
+
+layout(buffer_reference, std430, buffer_reference_align = 4) writeonly buffer Status
+{
+	uint dropped;
+};
+
+layout(buffer_reference, std430, buffer_reference_align = 4) buffer Words
+{
+	uint v[];
+};
+
+layout(push_constant) uniform Registers
+{
+	Params params;
+	uint mode;
+};
+
+uvec2 va_add(uvec2 va, uint offset)
+{
+	uint carry;
+	uint lo = uaddCarry(va.x, offset, carry);
+	return uvec2(lo, va.y + carry);
+}
+
+/* A 32-bit load at any byte address. */
+uint load_u32(uvec2 va, uint offset)
+{
+	uvec2 addr = va_add(va, offset);
+	uint shift = (addr.x & 3u) * 8u;
+	Words words = Words(uvec2(addr.x & ~3u, addr.y));
+	uint value = words.v[0];
+	if (shift != 0u)
+		value = (value >> shift) | (words.v[1] << (32u - shift));
+	return value;
+}
+
+/* A 16-bit load at any byte address. */
+uint load_u16(uvec2 va, uint offset)
+{
+	uvec2 addr = va_add(va, offset);
+	uint shift = (addr.x & 3u) * 8u;
+	Words words = Words(uvec2(addr.x & ~3u, addr.y));
+	uint value = words.v[0] >> shift;
+	if (shift == 24u)
+		value |= words.v[1] << 8u;
+	return value & 0xffffu;
+}
+
+uint api_word(uint sequence, uint word)
+{
+	return Words(params.api_buffer_va).v[sequence * params.api_stride_words + word];
+}
+
+uint sequence_count()
+{
+	uint count = params.max_commands;
+	if (any(notEqual(params.count_va, uvec2(0))))
+		count = min(count, Words(params.count_va).v[0]);
+	return count;
+}
+
+void layout_index()
+{
+	SequenceState state = SequenceState(params.state_va);
+	Totals totals = Totals(params.totals_va);
+	uint count = sequence_count();
+	uint total = 0u;
+	bool dropped = false;
+	uint i;
+
+	for (i = 0u; i < params.max_commands; i++)
+	{
+		uint index_count = 0u;
+
+		if (i < count)
+		{
+			uint draw_indices = api_word(i, params.draw_src_word);
+			uint draw_instances = api_word(i, params.draw_src_word + 1u);
+
+			if (draw_indices != 0u && draw_instances != 0u)
+			{
+				if (draw_indices <= params.index_budget - total)
+					index_count = draw_indices;
+				else
+					dropped = true;
+			}
+		}
+
+		state.seq[i].index_first = total;
+		state.seq[i].index_count = index_count;
+		state.seq[i].vertex_min = 0xffffffffu;
+		state.seq[i].vertex_max = 0u;
+		total += index_count;
+	}
+
+	totals.index_dispatch_x = (total + 63u) / 64u;
+	totals.index_dispatch_y = 1u;
+	totals.index_dispatch_z = 1u;
+	totals.index_total = total;
+	if (dropped)
+		Status(params.status_va).dropped = 1u;
+}
+
+void scan_index()
+{
+	SequenceState state = SequenceState(params.state_va);
+	uint element = gl_GlobalInvocationID.x;
+	uint lo = 0u, hi = params.max_commands;
+	uint index_va_lo, index_va_hi, index_size, index_format;
+	uint position, carry, value;
+	bool restart = false;
+
+	if (element >= Totals(params.totals_va).index_total)
+		return;
+
+	/* The last sequence that starts at or before this element. Empty sequences
+	 * share their start with the next one, so this never selects one. */
+	while (hi - lo > 1u)
+	{
+		uint mid = (lo + hi) / 2u;
+		if (state.seq[mid].index_first <= element)
+			lo = mid;
+		else
+			hi = mid;
+	}
+
+	if (params.ibv_src_word != NO_WORD)
+	{
+		index_va_lo = api_word(lo, params.ibv_src_word);
+		index_va_hi = api_word(lo, params.ibv_src_word + 1u);
+		index_size = api_word(lo, params.ibv_src_word + 2u);
+		index_format = api_word(lo, params.ibv_src_word + 3u);
+	}
+	else
+	{
+		index_va_lo = params.ib_va.x;
+		index_va_hi = params.ib_va.y;
+		index_size = params.ib_size;
+		index_format = params.ib_format;
+	}
+
+	/* StartIndexLocation plus the index within the draw. A missing index reads as 0. */
+	position = uaddCarry(api_word(lo, params.draw_src_word + 2u), element - state.seq[lo].index_first, carry);
+	value = 0u;
+
+	if (carry == 0u && (index_va_lo != 0u || index_va_hi != 0u))
+	{
+		if (index_format == DXGI_FORMAT_R32_UINT)
+		{
+			if (position < index_size / 4u)
+			{
+				value = load_u32(uvec2(index_va_lo, index_va_hi), position * 4u);
+				restart = value == 0xffffffffu;
+			}
+		}
+		else if (position < index_size / 2u)
+		{
+			value = load_u16(uvec2(index_va_lo, index_va_hi), position * 2u);
+			restart = value == 0xffffu;
+		}
+	}
+
+	if (restart && (params.flags & FLAG_RESTART) != 0u)
+	{
+		value = 0xffffffffu;
+	}
+	else
+	{
+		atomicMin(state.seq[lo].vertex_min, value);
+		atomicMax(state.seq[lo].vertex_max, value);
+	}
+
+	Words(params.index_scratch_va).v[element] = value;
+}
+
+void layout_vertex()
+{
+	SequenceState state = SequenceState(params.state_va);
+	Totals totals = Totals(params.totals_va);
+	Words slots = Words(params.slots_va);
+	bool indexed = (params.flags & FLAG_INDEXED) != 0u;
+	bool copy_vertices = (params.flags & FLAG_COPY_VERTICES) != 0u;
+	bool copy_instances = (params.flags & FLAG_COPY_INSTANCES) != 0u;
+	uint count = sequence_count();
+	uint vertex_total = 0u;
+	uint instance_total = 0u;
+	bool dropped = false;
+	uint i;
+
+	for (i = 0u; i < params.max_commands; i++)
+	{
+		uint draw_elements = 0u, draw_instances = 0u, draw_first = 0u, draw_base = 0u, draw_first_instance = 0u;
+		uint vertex_min = 0u, vertex_count = 0u, instance_count = 0u;
+		uint word = i * params.slot_stride_words + params.slot_action_word;
+		bool draw = false;
+
+		if (i < count)
+		{
+			draw_elements = api_word(i, params.draw_src_word);
+			draw_instances = api_word(i, params.draw_src_word + 1u);
+			draw_first = api_word(i, params.draw_src_word + 2u);
+
+			if (indexed)
+			{
+				draw_base = api_word(i, params.draw_src_word + 3u);
+				draw_first_instance = api_word(i, params.draw_src_word + 4u);
+				/* Zero when LAYOUT_INDEX found no room for the indices. */
+				draw_elements = state.seq[i].index_count;
+			}
+			else
+			{
+				draw_first_instance = api_word(i, params.draw_src_word + 3u);
+			}
+
+			draw = draw_elements != 0u && draw_instances != 0u;
+		}
+
+		if (draw && copy_vertices)
+		{
+			if (indexed)
+			{
+				vertex_min = state.seq[i].vertex_min;
+				/* Every index was a strip cut: the draw has no vertices. */
+				if (vertex_min <= state.seq[i].vertex_max)
+				{
+					vertex_count = state.seq[i].vertex_max - vertex_min + 1u;
+					/* The whole 32-bit range never fits. */
+					if (vertex_count == 0u)
+						draw = false;
+				}
+				else
+				{
+					vertex_min = 0u;
+				}
+			}
+			else
+			{
+				vertex_min = draw_first;
+				vertex_count = draw_elements;
+			}
+
+			if (vertex_count > params.vertex_budget - vertex_total)
+				draw = false;
+		}
+
+		if (draw && copy_instances)
+		{
+			instance_count = draw_instances;
+			if (instance_count > params.instance_budget - instance_total)
+				draw = false;
+		}
+
+		if (i < count && !draw && draw_instances != 0u && api_word(i, params.draw_src_word) != 0u)
+			dropped = true;
+
+		if (!draw)
+		{
+			vertex_count = 0u;
+			instance_count = 0u;
+		}
+
+		state.seq[i].vertex_min = vertex_min;
+		state.seq[i].vertex_first = vertex_total;
+		state.seq[i].vertex_count = vertex_count;
+		state.seq[i].instance_first = instance_total;
+		state.seq[i].instance_count = instance_count;
+
+		if (draw)
+		{
+			slots.v[word] = draw_elements;
+			slots.v[word + 1u] = draw_instances;
+
+			if (indexed)
+			{
+				slots.v[word + 2u] = state.seq[i].index_first;
+				/* vertexOffset. The vertex shader still sees the application's index. */
+				slots.v[word + 3u] = copy_vertices ? vertex_total - vertex_min : draw_base;
+				slots.v[word + 4u] = copy_instances ? instance_total : draw_first_instance;
+			}
+			else
+			{
+				slots.v[word + 2u] = copy_vertices ? vertex_total : draw_first;
+				slots.v[word + 3u] = copy_instances ? instance_total : draw_first_instance;
+			}
+		}
+		else
+		{
+			/* The slot may hold the arguments of an earlier execution of this command list. */
+			slots.v[word] = 0u;
+			slots.v[word + 1u] = 0u;
+		}
+
+		vertex_total += vertex_count;
+		instance_total += instance_count;
+	}
+
+	totals.copy_dispatch_x = (vertex_total + instance_total + 63u) / 64u;
+	totals.copy_dispatch_y = 1u;
+	totals.copy_dispatch_z = 1u;
+	totals.vertex_total = vertex_total;
+	totals.instance_total = instance_total;
+	if (dropped)
+		Status(params.status_va).dropped = 1u;
+}
+
+void copy_element(uint sequence, uint binding, uint element, bool valid, uint dst_element)
+{
+	uint src_word = params.bindings[binding].src_word;
+	uint dst_stride = params.bindings[binding].dst_stride;
+	Words dst = Words(va_add(params.bindings[binding].dst_va, dst_element * dst_stride));
+	uint va_lo, va_hi, size, stride, offset, offset_hi, i;
+
+	if (src_word != NO_WORD)
+	{
+		va_lo = api_word(sequence, src_word);
+		va_hi = api_word(sequence, src_word + 1u);
+		size = api_word(sequence, src_word + 2u);
+		stride = api_word(sequence, src_word + 3u);
+	}
+	else
+	{
+		va_lo = params.bindings[binding].va.x;
+		va_hi = params.bindings[binding].va.y;
+		size = params.bindings[binding].size;
+		stride = params.bindings[binding].stride;
+	}
+
+	umulExtended(element, stride, offset_hi, offset);
+	valid = valid && offset_hi == 0u && (va_lo != 0u || va_hi != 0u);
+
+	/* Bytes outside the view read as 0. */
+	for (i = 0u; i < dst_stride; i += 4u)
+	{
+		uint value = 0u;
+		uint carry;
+		uint at = uaddCarry(offset, i, carry);
+
+		if (valid && carry == 0u && at < size)
+		{
+			value = load_u32(uvec2(va_lo, va_hi), at);
+			if (size - at < 4u)
+				value &= (1u << ((size - at) * 8u)) - 1u;
+		}
+
+		dst.v[i / 4u] = value;
+	}
+}
+
+void copy()
+{
+	SequenceState state = SequenceState(params.state_va);
+	Totals totals = Totals(params.totals_va);
+	bool indexed = (params.flags & FLAG_INDEXED) != 0u;
+	uint element = gl_GlobalInvocationID.x;
+	uint vertex_total = totals.vertex_total;
+	bool instances = element >= vertex_total;
+	uint lo = 0u, hi = params.max_commands;
+	uint first, src_element, carry, i;
+	bool valid;
+
+	if (instances)
+	{
+		element -= vertex_total;
+		if (element >= totals.instance_total)
+			return;
+	}
+
+	while (hi - lo > 1u)
+	{
+		uint mid = (lo + hi) / 2u;
+		first = instances ? state.seq[mid].instance_first : state.seq[mid].vertex_first;
+		if (first <= element)
+			lo = mid;
+		else
+			hi = mid;
+	}
+
+	if (instances)
+	{
+		/* StartInstanceLocation plus the element. */
+		src_element = uaddCarry(api_word(lo, params.draw_src_word + (indexed ? 4u : 3u)),
+				element - state.seq[lo].instance_first, carry);
+		valid = carry == 0u;
+	}
+	else if (indexed)
+	{
+		/* The index plus BaseVertexLocation, which is signed. */
+		uint index = state.seq[lo].vertex_min + (element - state.seq[lo].vertex_first);
+		int base = int(api_word(lo, params.draw_src_word + 3u));
+		src_element = uaddCarry(index, uint(base), carry);
+		valid = base < 0 ? carry != 0u : carry == 0u;
+	}
+	else
+	{
+		/* StartVertexLocation plus the vertex. */
+		src_element = uaddCarry(state.seq[lo].vertex_min, element - state.seq[lo].vertex_first, carry);
+		valid = carry == 0u;
+	}
+
+	for (i = 0u; i < params.binding_count; i++)
+	{
+		if (((params.bindings[i].flags & BINDING_INSTANCE_RATE) != 0u) == instances)
+			copy_element(lo, i, src_element, valid, element);
+	}
+}
+
+void main()
+{
+	if (mode == MODE_SCAN_INDEX)
+		scan_index();
+	else if (mode == MODE_COPY)
+		copy();
+	else if (gl_GlobalInvocationID.x == 0u)
+	{
+		if (mode == MODE_LAYOUT_INDEX)
+			layout_index();
+		else
+			layout_vertex();
+	}
+}
