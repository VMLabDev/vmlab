From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Wil Taylor <ai@wiltaylor.dev>
Date: Sat, 21 Nov 2026 03:22:20 +0000
Subject: [PATCH] vkd3d: Emulate ExecuteIndirect vertex and index buffer views
 without EXT_dgc.

The ExecuteIndirect emulation for devices without
VK_EXT_device_generated_commands dropped command signatures that set
vertex or index buffer views. Vulkan binds those buffers by handle while
recording, so a view that is read on the GPU cannot be bound.

Fetch the data instead. A compute shader reads each sequence's views and
draw arguments from the argument buffer, copies the indices and the
range of vertices and instances the draw uses into scratch buffers, and
writes draw arguments that point there. The scratch buffers are bound
for every sequence, and each sequence stays one indirect draw. Bindings
the signature does not set are copied too when they share a rate with
one it sets, because one draw gives them the same first element.

The scratch buffers have a fixed size. A draw that does not fit is
dropped, and the command allocator reports that when it is reset.

vmlab-win3d: docs/ei.md.
---
 libs/vkd3d/command.c                          | 410 +++++++++++++-
 libs/vkd3d/meson.build                        |   1 +
 libs/vkd3d/meta.c                             |  55 ++
 .../cs_execute_indirect_vertex_fetch.comp     | 524 ++++++++++++++++++
 libs/vkd3d/vkd3d_private.h                    |  99 ++++
 libs/vkd3d/vkd3d_shaders.h                    |   1 +
 6 files changed, 1068 insertions(+), 22 deletions(-)
 create mode 100644 libs/vkd3d/shaders/cs_execute_indirect_vertex_fetch.comp

diff --git a/libs/vkd3d/command.c b/libs/vkd3d/command.c
index af86b00..1cfdfc1 100644
--- a/libs/vkd3d/command.c
+++ b/libs/vkd3d/command.c
@@ -2922,6 +2922,25 @@ static void d3d12_command_allocator_free_command_pool(
     VK_CALL(vkDestroyCommandPool(device->vk_device, pool->vk_command_pool, NULL));
 }
 
+/* An emulated ExecuteIndirect that fetches vertices cannot know while recording how much
+ * its sequences draw. Say so when the GPU found more than its scratch buffers hold. */
+static void d3d12_command_allocator_report_execute_indirect_dropped(struct d3d12_command_allocator *allocator)
+{
+    size_t i, dropped = 0;
+
+    for (i = 0; i < allocator->execute_indirect_dropped_count; i++)
+        if (*allocator->execute_indirect_dropped[i])
+            dropped++;
+
+    if (dropped)
+    {
+        ERR("%zu emulated ExecuteIndirect call(s) dropped draws that did not fit the vertex scratch buffers. "
+                "Set VKD3D_EXECUTE_INDIRECT_VERTEX_BUDGET to the number of vertices one call may draw.\n", dropped);
+    }
+
+    allocator->execute_indirect_dropped_count = 0;
+}
+
 static ULONG d3d12_command_allocator_dec_ref(struct d3d12_command_allocator *allocator)
 {
     unsigned int i, j;
@@ -2985,6 +3004,9 @@ static ULONG d3d12_command_allocator_dec_ref(struct d3d12_command_allocator *all
         d3d12_command_allocator_free_command_pool(&allocator->primary_pool, device);
         d3d12_command_allocator_free_command_pool(&allocator->fallback_pool, device);
 
+        d3d12_command_allocator_report_execute_indirect_dropped(allocator);
+        vkd3d_free(allocator->execute_indirect_dropped);
+
         for (i = 0; i < VKD3D_SCRATCH_POOL_KIND_COUNT; i++)
         {
             for (j = 0; j < allocator->scratch_pools[i].scratch_buffer_count; j++)
@@ -3133,6 +3155,8 @@ static HRESULT STDMETHODCALLTYPE d3d12_command_allocator_Reset(ID3D12CommandAllo
     if (FAILED(hr = d3d12_command_allocator_reset_command_pool(device, &allocator->fallback_pool)))
         return hr;
 
+    d3d12_command_allocator_report_execute_indirect_dropped(allocator);
+
     /* Return scratch buffers to the device */
     for (i = 0; i < VKD3D_SCRATCH_POOL_KIND_COUNT; i++)
     {
@@ -7123,6 +7147,8 @@ static void d3d12_command_list_reset_api_state(struct d3d12_command_list *list,
 
     list->index_buffer.buffer = VK_NULL_HANDLE;
     list->index_buffer.is_dirty = true;
+    list->index_buffer_va = 0;
+    memset(list->vertex_buffer_vas, 0, sizeof(list->vertex_buffer_vas));
 
     list->current_pipeline = VK_NULL_HANDLE;
     list->command_buffer_pipeline = VK_NULL_HANDLE;
@@ -13983,6 +14009,7 @@ static void STDMETHODCALLTYPE d3d12_command_list_IASetIndexBuffer(d3d12_command_
     TRACE("iface %p, view %p.\n", iface, view);
 
     list->index_buffer.is_dirty = true;
+    list->index_buffer_va = 0;
 
     if (!view || view->SizeInBytes == 0)
     {
@@ -14017,6 +14044,7 @@ static void STDMETHODCALLTYPE d3d12_command_list_IASetIndexBuffer(d3d12_command_
             list->index_buffer.buffer = resource->vk_buffer;
             list->index_buffer.offset = view->BufferLocation - resource->va;
             list->index_buffer.size = view->SizeInBytes;
+            list->index_buffer_va = view->BufferLocation;
         }
         else
         {
@@ -14103,6 +14131,7 @@ static void STDMETHODCALLTYPE d3d12_command_list_IASetVertexBuffers(d3d12_comman
         dyn_state->vertex_buffers[start_slot + i] = buffer;
         dyn_state->vertex_offsets[start_slot + i] = offset;
         dyn_state->vertex_sizes[start_slot + i] = size;
+        list->vertex_buffer_vas[start_slot + i] = invalid_va ? 0 : views[i].BufferLocation;
     }
 
     dyn_state->dirty_flags |= VKD3D_DYNAMIC_STATE_VERTEX_BUFFER_STRIDE;
@@ -16492,6 +16521,7 @@ static void d3d12_command_list_clear_signature_state(
                 /* Null IBO */
                 list->index_buffer.buffer = VK_NULL_HANDLE;
                 list->index_buffer.is_dirty = true;
+                list->index_buffer_va = 0;
                 break;
 
             case D3D12_INDIRECT_ARGUMENT_TYPE_VERTEX_BUFFER_VIEW:
@@ -16502,6 +16532,9 @@ static void d3d12_command_list_clear_signature_state(
                 list->dynamic_state.vertex_strides[slot] = 0;
                 list->dynamic_state.vertex_offsets[slot] = 0;
                 list->dynamic_state.vertex_sizes[slot] = 0;
+                list->dynamic_state.dirty_vbos |= 1u << slot;
+                list->dynamic_state.dirty_flags |= VKD3D_DYNAMIC_STATE_VERTEX_BUFFER_STRIDE;
+                list->vertex_buffer_vas[slot] = 0;
                 break;
             }
 
@@ -17099,6 +17132,253 @@ void d3d12_command_list_flush_dgc_batch(struct d3d12_command_list *list)
             state ? &state->ID3D12PipelineState_iface : NULL);
 }
 
+struct vkd3d_execute_indirect_vertex_fetch
+{
+    struct vkd3d_scratch_allocation params;
+    struct vkd3d_scratch_allocation totals;
+    struct vkd3d_scratch_allocation index_scratch;
+    struct vkd3d_scratch_allocation vertex_scratch[D3D12_IA_VERTEX_INPUT_RESOURCE_SLOT_COUNT];
+    VkDeviceSize vertex_sizes[D3D12_IA_VERTEX_INPUT_RESOURCE_SLOT_COUNT];
+    VkDeviceSize vertex_strides[D3D12_IA_VERTEX_INPUT_RESOURCE_SLOT_COUNT];
+    uint32_t copy_mask;
+    bool indexed;
+};
+
+/* How many vertices one emulated ExecuteIndirect can fetch, over all its sequences.
+ * It has four times as many indices. Draws that do not fit are dropped, and the
+ * command allocator reports that when it is reset. */
+static uint32_t d3d12_execute_indirect_vertex_budget(uint32_t max_command_count)
+{
+    char env[64];
+
+    if (vkd3d_get_env_var("VKD3D_EXECUTE_INDIRECT_VERTEX_BUDGET", env, sizeof(env)) && env[0])
+        return (uint32_t)min(max(strtoull(env, NULL, 0), 1ull), 1ull << 26);
+
+    return (uint32_t)min(max((uint64_t)max_command_count * 1024u, 1ull << 14), 1ull << 20);
+}
+
+static bool d3d12_command_list_prepare_execute_indirect_vertex_fetch(
+        struct d3d12_command_list *list, struct d3d12_command_signature *signature,
+        uint32_t max_command_count, VkDeviceAddress api_buffer_va, VkDeviceAddress indirect_count_va,
+        const struct vkd3d_scratch_allocation *slot_allocation,
+        struct vkd3d_execute_indirect_vertex_fetch *fetch)
+{
+    const struct vkd3d_dynamic_state *dyn_state = &list->dynamic_state;
+    struct vkd3d_execute_indirect_vertex_fetch_binding *binding;
+    struct d3d12_command_allocator *allocator = list->allocator;
+    struct vkd3d_execute_indirect_vertex_fetch_params *params;
+    const struct d3d12_graphics_pipeline_state *graphics;
+    uint32_t vertex_rate_mask, instance_rate_mask, mask;
+    struct vkd3d_scratch_allocation state_allocation;
+    uint32_t budget, max_stride, stride;
+    unsigned int slot;
+
+    memset(fetch, 0, sizeof(*fetch));
+
+    if (!list->state || list->state->pipeline_type != VKD3D_PIPELINE_TYPE_GRAPHICS)
+    {
+        WARN("No graphics pipeline bound, ignoring ExecuteIndirect.\n");
+        return false;
+    }
+
+    graphics = &list->state->graphics;
+    fetch->indexed = signature->desc.pArgumentDescs[signature->desc.NumArgumentDescs - 1].Type ==
+            D3D12_INDIRECT_ARGUMENT_TYPE_DRAW_INDEXED;
+
+    vertex_rate_mask = 0;
+    instance_rate_mask = 0;
+    max_stride = 4;
+    mask = graphics->vertex_buffer_mask;
+    while (mask)
+    {
+        slot = vkd3d_bitmask_iter32(&mask);
+        if (graphics->input_rates[slot] == VK_VERTEX_INPUT_RATE_INSTANCE)
+            instance_rate_mask |= 1u << slot;
+        else
+            vertex_rate_mask |= 1u << slot;
+        max_stride = max(max_stride, align(graphics->minimum_vertex_buffer_dynamic_stride[slot], 4));
+    }
+
+    /* One draw gives every binding of a rate the same first element, so when the
+     * signature sets one binding, the others of that rate are copied with it. */
+    if (!(signature->emulation.vertex_buffer_mask & vertex_rate_mask))
+        vertex_rate_mask = 0;
+    if (!(signature->emulation.vertex_buffer_mask & instance_rate_mask))
+        instance_rate_mask = 0;
+    fetch->copy_mask = vertex_rate_mask | instance_rate_mask;
+
+    /* The shader computes scratch offsets in 32 bits. */
+    budget = d3d12_execute_indirect_vertex_budget(max_command_count);
+    budget = min(budget, (1u << 30) / max_stride);
+
+    if (!d3d12_command_allocator_allocate_scratch_memory(allocator, VKD3D_SCRATCH_POOL_KIND_UNIFORM_UPLOAD,
+            sizeof(*params), 16, ~0u, &fetch->params) || !fetch->params.host_ptr ||
+            !d3d12_command_allocator_allocate_scratch_memory(allocator, VKD3D_SCRATCH_POOL_KIND_DEVICE_STORAGE,
+            (VkDeviceSize)max_command_count * VKD3D_EXECUTE_INDIRECT_VERTEX_FETCH_STATE_SIZE,
+            16, ~0u, &state_allocation) ||
+            !d3d12_command_allocator_allocate_scratch_memory(allocator, VKD3D_SCRATCH_POOL_KIND_DEVICE_STORAGE,
+            VKD3D_EXECUTE_INDIRECT_VERTEX_FETCH_TOTALS_SIZE, 16, ~0u, &fetch->totals))
+    {
+        ERR("Failed to allocate ExecuteIndirect vertex fetch state.\n");
+        return false;
+    }
+
+    params = fetch->params.host_ptr;
+    memset(params, 0, sizeof(*params));
+    params->api_buffer_va = api_buffer_va;
+    params->count_va = indirect_count_va;
+    params->slots_va = slot_allocation->va;
+    params->state_va = state_allocation.va;
+    params->totals_va = fetch->totals.va;
+    params->status_va = fetch->params.va + offsetof(struct vkd3d_execute_indirect_vertex_fetch_params, dropped);
+    params->api_stride_words = signature->desc.ByteStride / sizeof(uint32_t);
+    params->slot_stride_words = signature->emulation.slot_stride / sizeof(uint32_t);
+    params->slot_action_word = signature->emulation.action_offset / sizeof(uint32_t);
+    params->draw_src_word = signature->emulation.action_src_word;
+    params->max_commands = max_command_count;
+    params->vertex_budget = budget;
+    params->instance_budget = budget;
+    params->ibv_src_word = UINT32_MAX;
+
+    if (vertex_rate_mask)
+        params->flags |= VKD3D_EXECUTE_INDIRECT_VERTEX_FETCH_COPY_VERTICES;
+    if (instance_rate_mask)
+        params->flags |= VKD3D_EXECUTE_INDIRECT_VERTEX_FETCH_COPY_INSTANCES;
+
+    if (fetch->indexed)
+    {
+        params->flags |= VKD3D_EXECUTE_INDIRECT_VERTEX_FETCH_INDEXED;
+        /* As vkCmdSetPrimitiveRestartEnable. In Vulkan, the index type gives the cut value. */
+        if (graphics->index_buffer_strip_cut_value != D3D12_INDEX_BUFFER_STRIP_CUT_VALUE_DISABLED &&
+                vk_primitive_topology_supports_restart(dyn_state->vk_primitive_topology))
+            params->flags |= VKD3D_EXECUTE_INDIRECT_VERTEX_FETCH_RESTART;
+
+        params->index_budget = min((uint64_t)budget * 4u, 1u << 28);
+        if (!d3d12_command_allocator_allocate_scratch_memory(allocator, VKD3D_SCRATCH_POOL_KIND_DEVICE_STORAGE,
+                (VkDeviceSize)params->index_budget * sizeof(uint32_t), 16, ~0u, &fetch->index_scratch))
+        {
+            ERR("Failed to allocate ExecuteIndirect index scratch.\n");
+            return false;
+        }
+        params->index_scratch_va = fetch->index_scratch.va;
+
+        if (signature->emulation.index_buffer_src_word != UINT32_MAX)
+        {
+            params->ibv_src_word = signature->emulation.index_buffer_src_word;
+        }
+        else if (list->index_buffer.buffer)
+        {
+            params->ib_va = list->index_buffer_va;
+            params->ib_size = min(list->index_buffer.size, UINT32_MAX);
+            params->ib_format = list->index_buffer.vk_type == VK_INDEX_TYPE_UINT32 ?
+                    DXGI_FORMAT_R32_UINT : DXGI_FORMAT_R16_UINT;
+        }
+    }
+
+    mask = fetch->copy_mask;
+    while (mask)
+    {
+        slot = vkd3d_bitmask_iter32(&mask);
+        stride = max(align(graphics->minimum_vertex_buffer_dynamic_stride[slot], 4), 4);
+        fetch->vertex_strides[slot] = stride;
+        fetch->vertex_sizes[slot] = (VkDeviceSize)budget * stride;
+
+        if (!d3d12_command_allocator_allocate_scratch_memory(allocator, VKD3D_SCRATCH_POOL_KIND_DEVICE_STORAGE,
+                fetch->vertex_sizes[slot], 16, ~0u, &fetch->vertex_scratch[slot]))
+        {
+            ERR("Failed to allocate ExecuteIndirect vertex scratch.\n");
+            return false;
+        }
+
+        binding = &params->bindings[params->binding_count++];
+        binding->dst_va = fetch->vertex_scratch[slot].va;
+        binding->dst_stride = stride;
+        if (instance_rate_mask & (1u << slot))
+            binding->flags |= VKD3D_EXECUTE_INDIRECT_VERTEX_FETCH_BINDING_INSTANCE_RATE;
+
+        if (signature->emulation.vertex_buffer_mask & (1u << slot))
+        {
+            binding->src_word = signature->emulation.vertex_buffer_src_word[slot];
+        }
+        else
+        {
+            binding->src_word = UINT32_MAX;
+            binding->va = list->vertex_buffer_vas[slot];
+            binding->size = min(dyn_state->vertex_sizes[slot], UINT32_MAX);
+            binding->stride = dyn_state->vertex_strides[slot];
+        }
+    }
+
+    if (!vkd3d_array_reserve((void **)&allocator->execute_indirect_dropped, &allocator->execute_indirect_dropped_size,
+            allocator->execute_indirect_dropped_count + 1, sizeof(*allocator->execute_indirect_dropped)))
+        return false;
+    allocator->execute_indirect_dropped[allocator->execute_indirect_dropped_count++] = &params->dropped;
+
+    return true;
+}
+
+static void d3d12_command_list_execute_indirect_vertex_fetch(struct d3d12_command_list *list,
+        struct d3d12_command_signature *signature, const struct vkd3d_execute_indirect_vertex_fetch *fetch)
+{
+    const struct vkd3d_vk_device_procs *vk_procs = &list->device->vk_procs;
+    VkCommandBuffer vk_cmd_buffer = list->cmd.vk_command_buffer;
+    struct vkd3d_execute_indirect_vertex_fetch_args args;
+    VkMemoryBarrier2 barrier;
+    VkDependencyInfo dep_info;
+    unsigned int mode;
+
+    memset(&barrier, 0, sizeof(barrier));
+    barrier.sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER_2;
+    barrier.srcStageMask = VK_PIPELINE_STAGE_2_COMPUTE_SHADER_BIT;
+    barrier.srcAccessMask = VK_ACCESS_2_SHADER_WRITE_BIT;
+    barrier.dstStageMask = VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT;
+    barrier.dstAccessMask = VK_ACCESS_2_SHADER_READ_BIT | VK_ACCESS_2_SHADER_WRITE_BIT |
+            VK_ACCESS_2_INDIRECT_COMMAND_READ_BIT | VK_ACCESS_2_UNIFORM_READ_BIT |
+            VK_ACCESS_2_VERTEX_ATTRIBUTE_READ_BIT | VK_ACCESS_2_INDEX_READ_BIT;
+
+    memset(&dep_info, 0, sizeof(dep_info));
+    dep_info.sType = VK_STRUCTURE_TYPE_DEPENDENCY_INFO;
+    dep_info.memoryBarrierCount = 1;
+    dep_info.pMemoryBarriers = &barrier;
+
+    VK_CALL(vkCmdBindPipeline(vk_cmd_buffer, VK_PIPELINE_BIND_POINT_COMPUTE,
+            signature->emulation.fetch_pipeline.vk_pipeline));
+
+    memset(&args, 0, sizeof(args));
+    args.params_va = fetch->params.va;
+
+    for (mode = VKD3D_EXECUTE_INDIRECT_VERTEX_FETCH_LAYOUT_INDEX;
+            mode <= VKD3D_EXECUTE_INDIRECT_VERTEX_FETCH_COPY; mode++)
+    {
+        /* A draw that is not indexed has no indices to lay out or scan. */
+        if (!fetch->indexed && mode < VKD3D_EXECUTE_INDIRECT_VERTEX_FETCH_LAYOUT_VERTEX)
+            continue;
+        if (!fetch->copy_mask && mode == VKD3D_EXECUTE_INDIRECT_VERTEX_FETCH_COPY)
+            continue;
+
+        args.mode = mode;
+        VK_CALL(vkCmdPushConstants(vk_cmd_buffer, signature->emulation.fetch_pipeline.vk_pipeline_layout,
+                VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof(args), &args));
+
+        switch (mode)
+        {
+            case VKD3D_EXECUTE_INDIRECT_VERTEX_FETCH_SCAN_INDEX:
+                VK_CALL(vkCmdDispatchIndirect(vk_cmd_buffer, fetch->totals.buffer, fetch->totals.offset));
+                break;
+            case VKD3D_EXECUTE_INDIRECT_VERTEX_FETCH_COPY:
+                VK_CALL(vkCmdDispatchIndirect(vk_cmd_buffer, fetch->totals.buffer,
+                        fetch->totals.offset + VKD3D_EXECUTE_INDIRECT_VERTEX_FETCH_COPY_DISPATCH_OFFSET));
+                break;
+            default:
+                /* One invocation does the work. */
+                VK_CALL(vkCmdDispatch(vk_cmd_buffer, 1, 1, 1));
+                break;
+        }
+
+        VK_CALL(vkCmdPipelineBarrier2(vk_cmd_buffer, &dep_info));
+    }
+}
+
 static void d3d12_command_list_execute_indirect_state_template_emulated(
         struct d3d12_command_list *list, struct d3d12_command_signature *signature,
         uint32_t max_command_count,
@@ -17106,9 +17386,11 @@ static void d3d12_command_list_execute_indirect_state_template_emulated(
         struct d3d12_resource *count_buffer, UINT64 count_buffer_offset)
 {
     const struct vkd3d_vk_device_procs *vk_procs = &list->device->vk_procs;
-    const struct d3d12_bind_point_layout *bind_point_layout;
+    const struct d3d12_bind_point_layout *bind_point_layout = NULL;
+    bool fetch_vertices = signature->emulation.fetch_vertices;
     struct vkd3d_scratch_allocation predication_allocation;
     const struct d3d12_root_signature *root_signature;
+    struct vkd3d_execute_indirect_vertex_fetch fetch;
     struct vkd3d_scratch_allocation count_allocation;
     struct vkd3d_scratch_allocation slot_allocation;
     struct vkd3d_execute_indirect_args patch_args;
@@ -17123,7 +17405,7 @@ static void d3d12_command_list_execute_indirect_state_template_emulated(
     VkCommandBuffer vk_cmd_buffer;
     VkMemoryBarrier2 barrier;
     VkDependencyInfo dep_info;
-    uint32_t stride, i;
+    uint32_t stride, i, mask;
     uint8_t *slot_ptr;
 
     action_type = signature->desc.pArgumentDescs[signature->desc.NumArgumentDescs - 1].Type;
@@ -17134,11 +17416,14 @@ static void d3d12_command_list_execute_indirect_state_template_emulated(
         return;
     }
 
-    bind_point_layout = d3d12_root_signature_get_layout(root_signature, signature->pipeline_type);
-    if (!(bind_point_layout->flags & VKD3D_ROOT_SIGNATURE_USE_PUSH_CONSTANT_UNIFORM_BLOCK))
+    if (signature->emulation.push_root_parameters)
     {
-        FIXME("Bound root signature does not use a push UBO, ignoring ExecuteIndirect.\n");
-        return;
+        bind_point_layout = d3d12_root_signature_get_layout(root_signature, signature->pipeline_type);
+        if (!(bind_point_layout->flags & VKD3D_ROOT_SIGNATURE_USE_PUSH_CONSTANT_UNIFORM_BLOCK))
+        {
+            FIXME("Bound root signature does not use a push UBO, ignoring ExecuteIndirect.\n");
+            return;
+        }
     }
 
     stride = signature->emulation.slot_stride;
@@ -17174,6 +17459,11 @@ static void d3d12_command_list_execute_indirect_state_template_emulated(
         return;
     }
 
+    /* The vertex layout comes from the bound pipeline, which is known before it is flushed. */
+    if (fetch_vertices && !d3d12_command_list_prepare_execute_indirect_vertex_fetch(list, signature,
+            max_command_count, arg_buffer->res.va + arg_buffer_offset, indirect_count_va, &slot_allocation, &fetch))
+        return;
+
     /* Patch the slots on the GPU, in order with the rest of the command list. Sequences past
      * the count keep their zeroed action arguments and draw or dispatch nothing. */
     d3d12_command_list_end_current_render_pass(list, false);
@@ -17208,6 +17498,7 @@ static void d3d12_command_list_execute_indirect_state_template_emulated(
         VK_CALL(vkCmdPipelineBarrier2(vk_cmd_buffer, &dep_info));
     }
 
+    /* A signature that sets only vertex or index buffer views has nothing to patch here. */
     if (signature->state_template.dgc.pipeline.vk_pipeline)
     {
         VK_CALL(vkCmdPushConstants(vk_cmd_buffer, signature->state_template.dgc.pipeline.vk_pipeline_layout,
@@ -17230,6 +17521,10 @@ static void d3d12_command_list_execute_indirect_state_template_emulated(
         VK_CALL(vkCmdPipelineBarrier2(vk_cmd_buffer, &dep_info));
     }
 
+    /* Copy what the sequences draw into the scratch buffers, and write their draw arguments. */
+    if (fetch_vertices)
+        d3d12_command_list_execute_indirect_vertex_fetch(list, signature, &fetch);
+
     /* Flush the application's state as for a normal draw or dispatch. */
     if (signature->pipeline_type == VKD3D_PIPELINE_TYPE_COMPUTE)
     {
@@ -17238,7 +17533,8 @@ static void d3d12_command_list_execute_indirect_state_template_emulated(
     }
     else
     {
-        if (action_type == D3D12_INDIRECT_ARGUMENT_TYPE_DRAW_INDEXED &&
+        /* With fetched vertices, the scratch index buffer is bound below instead. */
+        if (action_type == D3D12_INDIRECT_ARGUMENT_TYPE_DRAW_INDEXED && !fetch_vertices &&
                 !d3d12_command_list_update_index_buffer(list))
             return;
 
@@ -17248,7 +17544,7 @@ static void d3d12_command_list_execute_indirect_state_template_emulated(
             return;
