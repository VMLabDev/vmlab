+// Which surfaces the CPU blt takes. The source is a mappable blob (a Venus
+// image); the destination is a GDI surface or, for Desktop Duplication,
+// another mappable blob: dxgkrnl has DWM's context copy the desktop into a
+// shared surface that the capturing program made. The rule is in
+// viogpu_blt_map.h. A blob without the mappable flag is refused here, in
+// Present: its mapping would fail later, and Patch has no way to refuse.
 static BOOLEAN VioGpuCpuCopyBltSupported(VioGpuAllocation *src,
                                          VioGpuAllocation *dst)
 {
-    if (!src->IsBlob())
-    {
-        return FALSE;
-    }
-
-    if (!dst->IsBlob())
-    {
-        return TRUE;
-    }
-
-    return (src->GetBlobFlags() & VIRTGPU_BLOB_FLAG_USE_MAPPABLE) &&
-           (dst->GetBlobFlags() & VIRTGPU_BLOB_FLAG_USE_MAPPABLE);
+    return VioGpuBltSurfacesSupported(src->IsBlob(), src->GetBlobFlags(),
+                                      dst->IsBlob(), dst->GetBlobFlags())
+               ? TRUE
+               : FALSE;
 }
 
 NTSTATUS VioGpuCommand::SetCpuCopyBlt(VioGpuAllocation *src,
@@ -407,6 +401,41 @@ NTSTATUS VioGpuCommand::SetCpuCopyBlt(VioGpuAllocation *src,
     return STATUS_SUCCESS;
 }
 
+// Present calls this for a copy whose destination it does not map yet.
+// The source is a blob, and what decides whether a blob maps is what the
+// calling program wrote into the private data of its allocation: the blob
+// flags, a blob id the host may not know, a size the shared memory may not
+// hold. A failure here fails that one Present, and Patch has no way to
+// refuse. The mapping stays with the allocation, so Patch finds it made.
+NTSTATUS VioGpuCommand::MapCpuCopyBltSource(ULONG ctx_id)
+{
+    if (!m_cpuCopyBlt)
+    {
+        return STATUS_NOT_FOUND;
+    }
+
+    if (!m_cpuCopySrc)
+    {
+        return STATUS_INVALID_PARAMETER;
+    }
+
+    PVOID src_va = NULL;
+    ULONGLONG src_map_size = 0;
+    BOOLEAN src_io = FALSE;
+    NTSTATUS status = m_cpuCopySrc->MapForCpuCopy(ctx_id, &src_va,
+                                                  &src_map_size, &src_io);
+    if (!NT_SUCCESS(status))
+    {
+        DbgPrint(TRACE_LEVEL_WARNING,
+                 ("%s source map failed status=0x%x src_res=0x%x ctx=%u\n",
+                  __FUNCTION__, status, m_cpuCopySrc->GetId(), ctx_id));
+        return status;
+    }
+
+    m_cpuCopySrc->UnmapForCpuCopy(src_va, src_map_size, src_io);
+    return STATUS_SUCCESS;
+}
+
 NTSTATUS VioGpuCommand::MapCpuCopyBlt(ULONG ctx_id)
 {
     if (!m_cpuCopyBlt)
@@ -1421,16 +1450,20 @@ NTSTATUS VioGpuCommander::Patch(const DXGKARG_PATCH *pPatch)
     if (status != STATUS_NOT_FOUND && !NT_SUCCESS(status))
     {
         DbgPrint(TRACE_LEVEL_ERROR,
-                 ("%s ERROR owner=viogpu3d reason=cpu_blt_mapping_refresh_failed status=0x%x ctx=%u fence=%u priv=%p\n",
+                 ("%s ERROR owner=viogpu3d reason=cpu_blt_mapping_refresh_failed copy_dropped=1 status=0x%x ctx=%u fence=%u priv=%p\n",
                   __FUNCTION__,
                   status,
                   ctx_id,
                   pPatch->SubmissionFenceId,
                   pPatch->pDmaBufferPrivateData));
-        // WDDM treats any Patch failure as fatal (bugcheck 0x119/3).
-        // Fail closed: this is not recoverable error reporting, and success
-        // would retire an invalid CPU BLT as a successful NOP.
-        return status;
+        // Patch does not fail: upstream found that WDDM treats a Patch
+        // failure as fatal (bugcheck 0x119/3). Present has mapped the
+        // source blob, and refused the call when that failed. What can
+        // still fail here is a mapping that was lost since (a device reset
+        // between Present and Patch) or a destination without backing.
+        // MapCpuCopyBlt left the command without mappings: Run() then
+        // skips the copy, logs it, and retires the DMA buffer as the NOP
+        // it holds. One frame of one window is not copied.
     }
 
     return STATUS_SUCCESS;
