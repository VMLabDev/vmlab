From: vmlab-win3d
Subject: [PATCH] viogpu3d: let the host copy a Blt present when it offers to

Card #227 (docs/flip.md) left torn frames at 90 percent host load after the
host had ordered the flip. What it left is the copy of a present of the Blt
kind (windowed Direct3D 9, WPF, DirectDraw, blt-model DXGI, Desktop
Duplication): VioGpuCommand::Run does it on a guest CPU, row by row, into a
surface that the compositor reads on the host GPU, and no fence orders a
guest CPU against host GPU work.

When vmlab-hv offers VIRTIO_GPU_F_VMLAB_ORDERED_FLIP (23), Run sends
VIRTIO_GPU_CMD_VMLAB_PRESENT_COPY (0x0f01) on the control queue in place of
the CPU copy. The command names both resources, the image offset and row
pitch of each, the pixel conversion, and the boxes, which the code of the
CPU copy clips as before (VioGpuBltCopyRegion records a box instead of
copying). The host waits for its fences and the fences of both resources,
copies, and serves no later command before it is done, so the fenced NOP of
the present, which Run queues after it, completes after the copy.

A host that does not offer the bit (QEMU, an older vmlab-hv), or a command
that cannot be queued, leaves the copy on the guest CPU as before. Present
and Patch still map both surfaces: the host copies from the source's blob
mapping and into the destination's backing, which those mappings ensure.
---
diff --git a/viogpu/common/viogpu.h b/viogpu/common/viogpu.h
index c4a6643..cb59085 100644
--- a/viogpu/common/viogpu.h
+++ b/viogpu/common/viogpu.h
@@ -247,6 +247,40 @@ typedef struct virtio_gpu_vmlab_ordered_flip
 } GPU_VMLAB_ORDERED_FLIP, *PGPU_VMLAB_ORDERED_FLIP;
 #pragma pack()
 
+/* VIRTIO_GPU_CMD_VMLAB_PRESENT_COPY (VIRTIO_GPU_F_VMLAB_ORDERED_FLIP): the
+ * copy of a present of the Blt kind, which the host runs after its fences
+ * and those of both resources have signalled. It serves no later command of
+ * the control queue before the copy is done. The boxes follow the fixed
+ * part, count of them, already clipped to both surfaces. Mode is
+ * VIOGPU_BLT_COPY_MODE. */
+#define VIRTIO_GPU_CMD_VMLAB_PRESENT_COPY 0x0f01
+#pragma pack(1)
+typedef struct virtio_gpu_vmlab_present_copy
+{
+    GPU_CTRL_HDR hdr;
+    ULONG src_resource_id;
+    ULONG dst_resource_id;
+    ULONGLONG src_offset;
+    ULONGLONG dst_offset;
+    ULONG src_stride;
+    ULONG dst_stride;
+    ULONG mode;
+    ULONG bpp;
+    ULONG count;
+    ULONG padding;
+} GPU_VMLAB_PRESENT_COPY, *PGPU_VMLAB_PRESENT_COPY;
+
+typedef struct virtio_gpu_vmlab_copy_box
+{
+    ULONG src_x;
+    ULONG src_y;
+    ULONG dst_x;
+    ULONG dst_y;
+    ULONG width;
+    ULONG height;
+} GPU_VMLAB_COPY_BOX, *PGPU_VMLAB_COPY_BOX;
+#pragma pack()
+
 /* VIRTIO_GPU_CMD_TRANSFER_TO_HOST_2D: simple transfer to_host */
 #pragma pack(1)
 typedef struct virtio_gpu_transfer_to_host_2d
diff --git a/viogpu/common/viogpu_queue.cpp b/viogpu/common/viogpu_queue.cpp
index 2777008..4525271 100644
--- a/viogpu/common/viogpu_queue.cpp
+++ b/viogpu/common/viogpu_queue.cpp
@@ -1108,6 +1108,36 @@ UINT CtrlQueue::ResFlush(UINT res_id,
     return ret;
 }
 
+UINT CtrlQueue::PresentCopy(const GPU_VMLAB_PRESENT_COPY *fields, PGPU_VMLAB_COPY_BOX boxes)
+{
+    PGPU_VBUFFER vbuf = NULL;
+    PGPU_VMLAB_PRESENT_COPY cmd = (PGPU_VMLAB_PRESENT_COPY)AllocCmd(&vbuf, sizeof(*cmd));
+    if (!cmd || !vbuf)
+    {
+        delete[] reinterpret_cast<PBYTE>(boxes);
+        return (UINT)-1;
+    }
+    *cmd = *fields;
+    cmd->hdr.type = VIRTIO_GPU_CMD_VMLAB_PRESENT_COPY;
+    cmd->hdr.flags = 0;
+    cmd->hdr.fence_id = 0;
+
+    vbuf->data_buf = boxes;
+    vbuf->data_size = fields->count * sizeof(GPU_VMLAB_COPY_BOX);
+
+    // Unfenced: the queue's order is the point. The fenced NOP of the
+    // present follows it, and the host answers in order.
+    UINT ret = QueueBuffer(vbuf);
+    if (ret)
+    {
+        DbgPrint(TRACE_LEVEL_WARNING,
+                 ("%s failed to queue the host present copy src=%u dst=%u ret=%u\n",
+                  __FUNCTION__, fields->src_resource_id, fields->dst_resource_id, ret));
+        ReleaseBuffer(vbuf);
+    }
+    return ret;
+}
+
 PAGED_CODE_SEG_BEGIN
 
 void CtrlQueue::TransferToHost2D(UINT res_id, ULONG offset, UINT width, UINT height, UINT x, UINT y)
