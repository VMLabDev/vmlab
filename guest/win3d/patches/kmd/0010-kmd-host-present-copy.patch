+// With VIRTIO_GPU_F_VMLAB_ORDERED_FLIP the host runs the copy of a Blt
+// present (docs/present-copy.md). A copy on a guest CPU is ordered against
+// nothing that runs on the host: the compositor's GPU read of the
+// destination can overlap it. The host waits for its fences and those of
+// both resources first and holds the control queue while it copies, and the
+// fenced NOP of the present follows the command. The boxes are clipped here,
+// by the code of the CPU copy, so both paths copy the same pixels.
+static NTSTATUS VioGpuHostCopyBltPresent(VioGpuCommand *cmd,
+                                         CtrlQueue *queue,
+                                         VioGpuAllocation *src,
+                                         VioGpuAllocation *dst,
+                                         const RECT *srcRect,
+                                         const RECT *dstRect,
+                                         PVOID src_va,
+                                         ULONGLONG src_map_size,
+                                         PVOID dst_va,
+                                         ULONGLONG dst_map_size,
+                                         const RECT *subRects,
+                                         UINT subRectCnt)
+{
+    // One box per stored sub-rectangle, at most VIOGPU_BLT_MAX_SUBRECTS (64).
+    const UINT max_boxes = subRectCnt ? subRectCnt : 1;
+    PGPU_VMLAB_COPY_BOX boxes = reinterpret_cast<PGPU_VMLAB_COPY_BOX>(
+        new (NonPagedPoolNx) BYTE[max_boxes * sizeof(GPU_VMLAB_COPY_BOX)]);
+    if (!boxes)
+    {
+        return STATUS_INSUFFICIENT_RESOURCES;
+    }
+
+    UINT count = 0;
+    NTSTATUS status = VioGpuCpuCopyBltPresent(cmd, src, dst, srcRect, dstRect,
+                                              src_va, src_map_size,
+                                              dst_va, dst_map_size,
+                                              subRects, subRectCnt,
+                                              boxes, &count);
+    if (!NT_SUCCESS(status) || count == 0)
+    {
+        delete[] reinterpret_cast<PBYTE>(boxes);
+        return NT_SUCCESS(status) ? STATUS_INVALID_PARAMETER : status;
+    }
+
+    GPU_VMLAB_PRESENT_COPY fields;
+    RtlZeroMemory(&fields, sizeof(fields));
+    fields.src_resource_id = src->GetId();
+    fields.dst_resource_id = dst->GetId();
+    fields.src_offset = 0;
+    fields.dst_offset = dst->IsBlob() ? dst->GetScanoutOffset() : 0;
+    fields.src_stride = src->GetStride();
+    fields.dst_stride = dst->GetStride();
+    fields.mode = (ULONG)VioGpuBltCopyMode(src->GetFormat(), dst->GetFormat());
+    fields.bpp = VioGpuBltBytesPerPixel(dst->GetFormat());
+    fields.count = count;
+
+    return queue->PresentCopy(&fields, boxes) ? STATUS_UNSUCCESSFUL : STATUS_SUCCESS;
+}
