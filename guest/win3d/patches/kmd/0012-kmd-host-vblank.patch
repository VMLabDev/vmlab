From: vmlab-win3d
Subject: [PATCH] viogpu3d: take the vblank from the host's frame clock when it offers it

The vsync came from a guest timer: a DPC every 16.7 ms that sent the
recorded flip and then an empty SUBMIT_3D, whose completion interrupt
raised CRTC_VSYNC. Its period was the guest's timer resolution, and the
guest's clock, not the host display's (P2 of the win3d design,
docs/vblank.md).

When vmlab-hv offers VIRTIO_GPU_F_VMLAB_ORDERED_FLIP (23), StartVsyncTimer
starts no timer. It sends VIRTIO_GPU_CMD_VMLAB_VBLANK (0x0f02), which the
host holds, without holding the commands behind it, and answers at the next
tick of its 60 Hz frame clock with the tick and its host time. The
interrupt routine raises the vsync on that answer when no flip waits to be
sent. The completion of the wait, at DPC level, sends the waiting flip and
then the next wait. A flip sent so carries FlipShownDone on its flush, and
the answer to it, which the host gives once the frame is shown, raises the
vsync of that tick instead. A flip whose answer does not come within two
ticks does not stop the vsync.

A host that does not offer the bit (QEMU, an older vmlab-hv) leaves the
timer and its NOP as they were. So does a wait that the host refuses or that
cannot be queued: the driver falls back to the timer. A reset cancels the
wait, and a start on a new transport sends a new one. The trace build
records each host vblank as event 25.
---
diff --git a/viogpu/common/viogpu.h b/viogpu/common/viogpu.h
index 0c814435..86b6e8be 100644
--- a/viogpu/common/viogpu.h
+++ b/viogpu/common/viogpu.h
@@ -286,6 +286,31 @@ typedef struct virtio_gpu_vmlab_copy_box
 } GPU_VMLAB_COPY_BOX, *PGPU_VMLAB_COPY_BOX;
 #pragma pack()
 
+/* VIRTIO_GPU_CMD_VMLAB_VBLANK (VIRTIO_GPU_F_VMLAB_ORDERED_FLIP): wait for the
+ * next vblank of the host's frame clock. The host holds it, without holding
+ * the commands behind it, and answers VIRTIO_GPU_RESP_OK_VMLAB_VBLANK at the
+ * first tick after it arrived, with the tick's number and its host time
+ * (CLOCK_MONOTONIC, nanoseconds). No fence. */
+#define VIRTIO_GPU_CMD_VMLAB_VBLANK 0x0f02
+#define VIRTIO_GPU_RESP_OK_VMLAB_VBLANK 0x11f0
+#pragma pack(1)
+typedef struct virtio_gpu_vmlab_vblank
+{
+    GPU_CTRL_HDR hdr;
+    ULONG scanout_id;
+    ULONG padding;
+} GPU_VMLAB_VBLANK, *PGPU_VMLAB_VBLANK;
+
+typedef struct virtio_gpu_resp_vmlab_vblank
+{
+    GPU_CTRL_HDR hdr;
+    ULONGLONG sequence;
+    ULONGLONG timestamp_ns;
+    ULONG period_ns;
+    ULONG padding;
+} GPU_RESP_VMLAB_VBLANK, *PGPU_RESP_VMLAB_VBLANK;
+#pragma pack()
+
 /* VIRTIO_GPU_CMD_TRANSFER_TO_HOST_2D: simple transfer to_host */
 #pragma pack(1)
 typedef struct virtio_gpu_transfer_to_host_2d
diff --git a/viogpu/common/viogpu_queue.cpp b/viogpu/common/viogpu_queue.cpp
index 4525271c..ef478b57 100644
--- a/viogpu/common/viogpu_queue.cpp
+++ b/viogpu/common/viogpu_queue.cpp
@@ -1138,6 +1138,40 @@ UINT CtrlQueue::PresentCopy(const GPU_VMLAB_PRESENT_COPY *fields, PGPU_VMLAB_COP
     return ret;
 }
 
+UINT CtrlQueue::VblankWait(void (*complete_cb)(void *), void *complete_ctx)
+{
+    // The answer is larger than the inline response, so it has its own
+    // buffer. FreeBuf deletes it with the request.
+    PBYTE resp = new (NonPagedPoolNx) BYTE[sizeof(GPU_RESP_VMLAB_VBLANK)];
+    if (!resp)
+    {
+        return (UINT)-1;
+    }
+    RtlZeroMemory(resp, sizeof(GPU_RESP_VMLAB_VBLANK));
+    PGPU_VBUFFER vbuf = NULL;
+    PGPU_VMLAB_VBLANK cmd =
+        (PGPU_VMLAB_VBLANK)AllocCmdResp(&vbuf, sizeof(*cmd), resp, sizeof(GPU_RESP_VMLAB_VBLANK));
+    if (!cmd || !vbuf)
+    {
+        delete[] resp;
+        return (UINT)-1;
+    }
+    RtlZeroMemory(cmd, sizeof(*cmd));
+    cmd->hdr.type = VIRTIO_GPU_CMD_VMLAB_VBLANK;
+    cmd->scanout_id = 0;
+
+    vbuf->complete_cb = complete_cb;
+    vbuf->complete_ctx = complete_ctx;
+
+    UINT ret = QueueBuffer(vbuf);
+    if (ret)
+    {
+        DbgPrint(TRACE_LEVEL_WARNING, ("%s failed to queue the host vblank wait ret=%u\n", __FUNCTION__, ret));
+        ReleaseBuffer(vbuf);
+    }
+    return ret;
+}
+
 PAGED_CODE_SEG_BEGIN
 
 void CtrlQueue::TransferToHost2D(UINT res_id, ULONG offset, UINT width, UINT height, UINT x, UINT y)
diff --git a/viogpu/common/viogpu_queue.h b/viogpu/common/viogpu_queue.h
index 5b77b9d0..13b55300 100644
--- a/viogpu/common/viogpu_queue.h
+++ b/viogpu/common/viogpu_queue.h
@@ -313,6 +313,15 @@ class CtrlQueue : public VioGpuQueue
     // Queues VIRTIO_GPU_CMD_VMLAB_PRESENT_COPY. Takes ownership of boxes,
     // fields->count entries allocated with new[] from non-paged pool.
     UINT PresentCopy(const GPU_VMLAB_PRESENT_COPY *fields, PGPU_VMLAB_COPY_BOX boxes);
+    // The same bit offers the host's vblank.
+    BOOLEAN HasHostVblank() const
+    {
+        return m_OrderedFlip;
+    }
+    // Queues VIRTIO_GPU_CMD_VMLAB_VBLANK. complete_cb runs at the host's next
+    // tick, or with VIRTIO_GPU_RESP_ERR_UNSPEC when a reset cancels the wait.
+    // Non-zero when nothing was queued.
+    UINT VblankWait(void (*complete_cb)(void *), void *complete_ctx);
     UINT Flush();
 
     void CreateResource(UINT res_id, UINT format, UINT width, UINT height);
diff --git a/viogpu/viogpu3d/viogpu_adapter.cpp b/viogpu/viogpu3d/viogpu_adapter.cpp
index 406b469c..45d16080 100644
--- a/viogpu/viogpu3d/viogpu_adapter.cpp
+++ b/viogpu/viogpu3d/viogpu_adapter.cpp
@@ -3953,6 +3953,19 @@ BOOLEAN VioGpuAdapter::InterruptRoutine(_In_ ULONG MessageNumber)
                 const PGPU_CTRL_HDR traceResponse = reinterpret_cast<PGPU_CTRL_HDR>(pvbuf->resp_buf);
                 Trace(5, 0, 0, traceRequest->ctx_id, traceRequest->flags,
                       traceRequest->fence_id, traceResponse && len >= sizeof(*traceResponse) ? traceResponse->type : 0);
+                // The host's vblank (docs/vblank.md): its answer, or the
+                // answer to the flip that Flip() sent, raises the vsync below.
+                if (pvbuf->complete_cb == VioGpuVidPN::HostVblankDone)
+                {
+                    if (vidpn.OnHostVblankFromIsr(pvbuf, len))
+                    {
+                        InterlockedExchange(&vidpn.m_vsync, 1);
+                    }
+                }
+                else if (pvbuf->complete_cb == VioGpuVidPN::FlipShownDone && vidpn.OnFlipShownFromIsr())
+                {
+                    InterlockedExchange(&vidpn.m_vsync, 1);
+                }
                 if (pvbuf->complete_cb == VioGpuCommand::RunningCbDone && pvbuf->complete_ctx != NULL)
                 {
                     VioGpuCommand *cmd = reinterpret_cast<VioGpuCommand *>(pvbuf->complete_ctx);
diff --git a/viogpu/viogpu3d/viogpu_adapter.h b/viogpu/viogpu3d/viogpu_adapter.h
index 4abc3424..2b55ff43 100644
--- a/viogpu/viogpu3d/viogpu_adapter.h
+++ b/viogpu/viogpu3d/viogpu_adapter.h
@@ -355,6 +355,7 @@ class VioGpuAdapter : IVioGpuPCI, public IVioGpuQueueSync
     }
 #endif
     BOOLEAN IsRecovering() const { return m_tdr.RecoveryState != 0; }
+    LONG TransportGeneration() const { return m_transportGeneration; }
     // vmlab-hv reported VIRTIO_GPU_EVENT_VMLAB_DEVICE_LOST: the host GPU is
