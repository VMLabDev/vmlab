                                      UINT y,
                                      UINT format,
                                      UINT stride,
-                                     UINT offset)
+                                     UINT offset,
+                                     void (*complete_cb)(void *),
+                                     void *complete_ctx)
 {
     DbgPrint(TRACE_LEVEL_VERBOSE,
              ("---> %s res_id=%d scanout=%u rect=%ux%u+%u+%u format=%u stride=%u offset=%u\n",
@@ -683,7 +690,7 @@ void VioGpuAllocation::FlushToScreen(UINT scan_id,
     {
         m_adapter->ctrlQueue.SetScanout(scan_id, m_Id, width, height, x, y);
     }
-    m_adapter->ctrlQueue.ResFlush(m_Id, width, height, x, y);
+    m_adapter->ctrlQueue.ResFlush(m_Id, width, height, x, y, complete_cb, complete_ctx);
 
     DbgPrint(TRACE_LEVEL_VERBOSE, ("<--- %s res_id=%d\n", __FUNCTION__, m_Id));
 }
diff --git a/viogpu/viogpu3d/viogpu_allocation.h b/viogpu/viogpu3d/viogpu_allocation.h
index 1ef2bc9b..1b4a9f11 100644
--- a/viogpu/viogpu3d/viogpu_allocation.h
+++ b/viogpu/viogpu3d/viogpu_allocation.h
@@ -109,6 +109,8 @@ class VioGpuAllocation
     void DetachBacking();
 
     void FlushToScreen(UINT scan_id);
+    // The same, with a completion on the flush of the flip.
+    void FlushToScreen(UINT scan_id, void (*complete_cb)(void *), void *complete_ctx);
     void FlushToScreen(UINT scan_id,
                        UINT width,
                        UINT height,
@@ -116,7 +118,9 @@ class VioGpuAllocation
                        UINT y,
                        UINT format,
                        UINT stride,
-                       UINT offset);
+                       UINT offset,
+                       void (*complete_cb)(void *) = NULL,
+                       void *complete_ctx = NULL);
 
     static NTSTATUS GetStandardAllocationDriverData(DXGKARG_GETSTANDARDALLOCATIONDRIVERDATA *pStandardAllocation);
     static NTSTATUS DxgkCreateAllocation(VioGpuAdapter *adapter, DXGKARG_CREATEALLOCATION *pCreateAllocation);
diff --git a/viogpu/viogpu3d/viogpu_vidpn.cpp b/viogpu/viogpu3d/viogpu_vidpn.cpp
index a843a32b..afe72a3e 100644
--- a/viogpu/viogpu3d/viogpu_vidpn.cpp
+++ b/viogpu/viogpu3d/viogpu_vidpn.cpp
@@ -1999,6 +1999,27 @@ VOID VioGpuVidPN::StartVsyncTimer(void)
 {
     ASSERT(KeGetCurrentIrql() == PASSIVE_LEVEL);
 
+    if (m_pAdapter->ctrlQueue.HasHostVblank())
+    {
+        // The host's frame clock answers a wait at each vblank, and the
+        // answer raises the vsync: no timer and no empty command per tick.
+        InterlockedExchange(&m_hostVblank, 1);
+        InterlockedExchange(&m_hostVblankFailed, 0);
+        InterlockedExchange(&m_flipVsyncOwed, 0);
+        InterlockedExchange(&m_shouldFlipStop, 0);
+        const LONG generation = m_pAdapter->TransportGeneration();
+        // A wait sent before a stop may still be on the queue. It goes on
+        // ticking, unless the transport was made again since.
+        if (InterlockedCompareExchange(&m_vblankArmed, 1, 0) == 0 || m_vblankGeneration != generation)
+        {
+            InterlockedExchange(&m_vblankArmed, 1);
+            m_vblankGeneration = generation;
+            SubmitHostVblank();
+        }
+        return;
+    }
+    InterlockedExchange(&m_hostVblank, 0);
+
     if (!m_timerRes)
     {
         m_timerRes = ExSetTimerResolution(10000, TRUE);
@@ -2072,7 +2093,15 @@ void VioGpuVidPN::Flip()
         }
 
         m_pAdapter->FlipTrace(19, 0, sourceRes ? sourceRes->GetId() : 0);
-        if (sourceRes != NULL)
+        if (sourceRes != NULL && InterlockedCompareExchange(&m_hostVblank, 0, 0))
+        {
+            // The vsync of this tick waits for the host's answer to the
+            // flip, which comes once the frame is shown (docs/vblank.md).
+            m_flipVsyncOwedTicks = 0;
+            InterlockedExchange(&m_flipVsyncOwed, 1);
+            sourceRes->FlushToScreen(0, FlipShownDone, this);
+        }
+        else if (sourceRes != NULL)
         {
             sourceRes->FlushToScreen(0);
         }
@@ -2202,6 +2231,100 @@ void VioGpuVidPN::VsyncNotifyTimerDpc(KDPC *dpc, PVOID deferredContext, PVOID sy
     KeReleaseSpinLockFromDpcLevel(&vidpn->m_vsyncTimerLock);
 }
 
+void VioGpuVidPN::SubmitHostVblank(void)
+{
+    if (m_pAdapter->ctrlQueue.VblankWait(HostVblankDone, this))
+    {
+        FallBackToTimer();
+    }
+}
+
+// The host's vblank cannot be had: the timer and its NOP take over, as on a
+// host without the bit. The timer runs at the resolution Windows has.
+void VioGpuVidPN::FallBackToTimer(void)
+{
+    InterlockedExchange(&m_hostVblank, 0);
+    InterlockedExchange(&m_flipVsyncOwed, 0);
+    InterlockedExchange(&m_vblankArmed, 0);
+    DbgPrint(TRACE_LEVEL_ERROR, ("%s: the host's vblank failed; the vsync timer takes over\n", __FUNCTION__));
+
+    LARGE_INTEGER now;
+    LARGE_INTEGER due;
+    KeQuerySystemTime(&now);
+    next_vsync_time.QuadPart = now.QuadPart + kVsyncPeriod100ns;
+    due.QuadPart = -kVsyncPeriod100ns;
+    KIRQL oldIrql;
+    KeAcquireSpinLock(&m_vsyncTimerLock, &oldIrql);
+    if (InterlockedCompareExchange(&m_shouldFlipStop, 0, 0) == 0)
+    {
+        KeSetTimerEx(&m_vsyncNotifyTimer, due, 0, &m_vsyncNotifyDpc);
+    }
+    KeReleaseSpinLock(&m_vsyncTimerLock, oldIrql);
+}
+
+BOOLEAN VioGpuVidPN::OnHostVblankFromIsr(struct virtio_gpu_vbuffer *pvbuf, UINT len)
+{
+    const PGPU_RESP_VMLAB_VBLANK resp = reinterpret_cast<PGPU_RESP_VMLAB_VBLANK>(pvbuf->resp_buf);
+    if (!resp || len < sizeof(*resp) || resp->hdr.type != VIRTIO_GPU_RESP_OK_VMLAB_VBLANK)
+    {
+        InterlockedExchange(&m_hostVblankFailed, 1);
+        return FALSE;
+    }
+    InterlockedExchange64(&m_hostVblankSequence, (LONG64)resp->sequence);
+    InterlockedExchange64(&m_hostVblankTimeNs, (LONG64)resp->timestamp_ns);
+
+    BOOLEAN raise;
+    if (InterlockedCompareExchange(&m_flipVsyncOwed, 0, 0))
+    {
+        // The flip sent at the last tick is not shown yet. Its answer raises
+        // the vsync, unless it never comes.
+        raise = ++m_flipVsyncOwedTicks >= 2 && InterlockedExchange(&m_flipVsyncOwed, 0) != 0;
+    }
+    else
+    {
+        // A flip waiting to be sent is sent from the completion of this
+        // wait, and its answer raises the vsync. Without one this is it.
+        raise = InterlockedCompareExchange(&m_shouldFlip, 0, 0) == 0;
+    }
+    m_pAdapter->FlipTrace(25, 0, (UINT)resp->sequence, resp->timestamp_ns, raise ? 1 : 0);
+    return raise;
+}
+
+BOOLEAN VioGpuVidPN::OnFlipShownFromIsr(void)
+{
+    return InterlockedExchange(&m_flipVsyncOwed, 0) != 0;
+}
+
+void VioGpuVidPN::FlipShownDone(void *ctx)
+{
+    // A marker for the interrupt routine, which raised the vsync already.
+    UNREFERENCED_PARAMETER(ctx);
+}
+
+void VioGpuVidPN::HostVblankDone(void *ctx)
+{
+    VioGpuVidPN *vidpn = reint