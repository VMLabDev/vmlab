Subject: [PATCH] viogpu3d: allow a present copy into a mappable blob

A program that captures the screen with DXGI Desktop Duplication got no
picture: DuplicateOutput succeeded and every AcquireNextFrame returned
DXGI_ERROR_ACCESS_LOST. For each frame dxgkrnl has DWM's context copy the
desktop into the duplication surface through DxgkDdiPresent with Blt, and a
trace of Microsoft-Windows-DxgKrnl showed that copy failing
(OutputDuplicationBlit, Status=0xC00000BB, STATUS_NOT_SUPPORTED).

In a Venus context the driver does a present copy on the CPU, and only from
a Venus image into a GDI surface: SetCpuCopyBlt and VioGpuCpuCopyBltPresent
refused every blob destination. The duplication surface is a blob.

A present copy into a blob is now allowed when source and destination are
both mappable blobs. The destination is mapped in Present, where a refusal
fails only that call: a blob's mapping does not depend on residency, and
Patch has no way to refuse. The copy writes at the image's offset in the
blob, the offset a scanout of that blob would use, with the row pitch the
user-mode driver gave for the allocation.

The user-mode half is patches/mesa/0095, which gives the duplication surface
mappable memory and a row pitch. Without it the destination blob is not
mappable and the copy is refused as before.

Evidence: docs/present.md ("Desktop Duplication").
Origin: GitHub VMLabDev/vmlab#237, carried onto e9917ae2 by card #146.
---
diff --git a/viogpu/viogpu3d/viogpu_command.cpp b/viogpu/viogpu3d/viogpu_command.cpp
index ee9565ff..0c4d6418 100644
--- a/viogpu/viogpu3d/viogpu_command.cpp
+++ b/viogpu/viogpu3d/viogpu_command.cpp
@@ -312,6 +312,28 @@ void VioGpuCommand::ClearCpuCopyBlt()
     RtlZeroMemory(m_cpuCopySubRects, sizeof(m_cpuCopySubRects));
 }
 
+// Which surfaces the CPU blt takes. The source is a blob (a Venus image);
+// the destination is a GDI surface or, for Desktop Duplication, another
+// blob: dxgkrnl has DWM's context copy the desktop into a shared surface
+// that the capturing program made. Both blobs must then be mappable, so
+// that the mapping can be made in Present and cannot fail in Patch.
+static BOOLEAN VioGpuCpuCopyBltSupported(VioGpuAllocation *src,
+                                         VioGpuAllocation *dst)
+{
+    if (!src->IsBlob())
+    {
+        return FALSE;
+    }
+
+    if (!dst->IsBlob())
+    {
+        return TRUE;
+    }
+
+    return (src->GetBlobFlags() & VIRTGPU_BLOB_FLAG_USE_MAPPABLE) &&
+           (dst->GetBlobFlags() & VIRTGPU_BLOB_FLAG_USE_MAPPABLE);
+}
+
 NTSTATUS VioGpuCommand::SetCpuCopyBlt(VioGpuAllocation *src,
                                       VioGpuAllocation *dst,
                                       const RECT *srcRect,
@@ -326,7 +348,7 @@ NTSTATUS VioGpuCommand::SetCpuCopyBlt(VioGpuAllocation *src,
         return STATUS_INVALID_PARAMETER;
     }
 
-    if (!src->IsBlob() || dst->IsBlob())
+    if (!VioGpuCpuCopyBltSupported(src, dst))
     {
         return STATUS_NOT_SUPPORTED;
     }
@@ -585,7 +607,7 @@ static NTSTATUS VioGpuCpuCopyBltPresent(VioGpuCommand *cmd,
         return STATUS_INVALID_PARAMETER;
     }
 
-    if (!src->IsBlob() || dst->IsBlob())
+    if (!VioGpuCpuCopyBltSupported(src, dst))
     {
         return STATUS_NOT_SUPPORTED;
     }
@@ -610,6 +632,18 @@ static NTSTATUS VioGpuCpuCopyBltPresent(VioGpuCommand *cmd,
     const LONG dx = srcRect->left - dstRect->left;
     const LONG dy = srcRect->top - dstRect->top;
 
+    if (dst->IsBlob())
+    {
+        // The image starts at its offset in the blob, as a scanout does.
+        const ULONGLONG image_offset = dst->GetScanoutOffset();
+        if (image_offset >= dst_map_size)
+        {
+            return STATUS_INVALID_PARAMETER;
+        }
+        dst_va = (PUCHAR)dst_va + image_offset;
+        dst_map_size -= image_offset;
+    }
+
     if (copy_mode == VIOGPU_BLT_COPY_UNSUPPORTED)
     {
         DbgPrint(TRACE_LEVEL_WARNING,
diff --git a/viogpu/viogpu3d/viogpu_device.cpp b/viogpu/viogpu3d/viogpu_device.cpp
index dc59bbbb..62b616f8 100644
--- a/viogpu/viogpu3d/viogpu_device.cpp
+++ b/viogpu/viogpu3d/viogpu_device.cpp
@@ -418,9 +418,13 @@ NTSTATUS VioGpuDevice::Present(_Inout_ DXGKARG_PRESENT *pPresent)
                 return stageStatus;
             }
             else if (src && dst &&
-                     ((dxgk_src->SegmentId != 0 && dxgk_dst->SegmentId != 0) ||
+                     (dst->IsBlob() ||
+                      (dxgk_src->SegmentId != 0 && dxgk_dst->SegmentId != 0) ||
                       (src->HasCpuCopyBacking() && dst->HasCpuCopyBacking())))
             {
+                // A blob destination (Desktop Duplication) is always mapped
+                // here: a blob's mapping does not depend on residency, and a
+                // refusal must fail this Present, never the Patch.
                 // Nonzero SegmentId is VidMm's pre-patched residency
                 // contract: Patch may be skipped even if the blob's CPU
                 // mapping has not been established by an earlier Present.
