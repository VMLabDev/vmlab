diff --git a/viogpu/shared/pipe_bounds.h b/viogpu/shared/pipe_bounds.h
new file mode 100644
index 0000000..a7a4700
--- /dev/null
+++ b/viogpu/shared/pipe_bounds.h
@@ -0,0 +1,91 @@
+#pragma once
+
+// The read of one message from the pipe of the two helpers (vgpusrv.exe and
+// viogpuap.exe), with every bound in one place. No include: the host test
+// tests/kmd/pipe_bounds_test.cpp of the vmlab-win3d package compiles this
+// file as it is, with a pipe of its own.
+//
+// The buffer has `length` units (wchar_t on Windows, 2 bytes). A message may
+// fill all of them but the last, which stays zero, so that the buffer is
+// always a terminated string. The bytes behind the message are zeroed too:
+// a sender ends its text in the middle of a unit (see PipeServer::Write).
+//
+// read_piece(destination, room, &got) reads at most `room` bytes of the
+// current message and returns VIOGPU_PIPE_PIECE_LAST when the message is
+// complete, VIOGPU_PIPE_PIECE_MORE when the message has more bytes
+// (ERROR_MORE_DATA of a pipe in message read mode), and
+// VIOGPU_PIPE_PIECE_ERROR when the read failed.
+
+enum
+{
+    VIOGPU_PIPE_PIECE_ERROR = -1,
+    VIOGPU_PIPE_PIECE_MORE = 0,
+    VIOGPU_PIPE_PIECE_LAST = 1,
+};
+
+enum
+{
+    // The read failed, or the message was empty. The buffer is an empty string.
+    VIOGPU_PIPE_READ_FAILED = 0,
+    // The buffer holds the message.
+    VIOGPU_PIPE_READ_OK = 1,
+    // The message did not fit. All of it was taken off the pipe and thrown
+    // away, and the buffer is an empty string.
+    VIOGPU_PIPE_READ_TOO_LONG = 2,
+};
+
+// The bytes of the longest message a buffer of `length` units takes.
+template <class Unit> unsigned int VioGpuPipeMessageRoom(unsigned int length)
+{
+    return length ? (length - 1) * (unsigned int)sizeof(Unit) : 0;
+}
+
+template <class Unit, class ReadPiece>
+int VioGpuPipeReadMessage(Unit *buffer, unsigned int length, ReadPiece read_piece)
+{
+    unsigned char *bytes = (unsigned char *)buffer;
+    const unsigned int capacity = length * (unsigned int)sizeof(Unit);
+    const unsigned int room = VioGpuPipeMessageRoom<Unit>(length);
+    unsigned int used = 0;
+    int result = VIOGPU_PIPE_READ_FAILED;
+
+    for (;;)
+    {
+        unsigned int got = 0;
+        int piece;
+
+        if (used == room)
+        {
+            // No room, and the message goes on: read the rest into a
+            // scratch buffer, so that the next read starts at a message.
+            unsigned char scratch[256];
+            do
+            {
+                got = 0;
+                piece = read_piece((void *)scratch, (unsigned int)sizeof(scratch), &got);
+            } while (piece == VIOGPU_PIPE_PIECE_MORE && got <= sizeof(scratch));
+            result = piece == VIOGPU_PIPE_PIECE_LAST ? VIOGPU_PIPE_READ_TOO_LONG : VIOGPU_PIPE_READ_FAILED;
+            used = 0;
+            break;
+        }
+
+        piece = read_piece((void *)(bytes + used), room - used, &got);
+        if (piece == VIOGPU_PIPE_PIECE_ERROR || got > room - used)
+        {
+            used = 0;
+            break;
+        }
+        used += got;
+        if (piece == VIOGPU_PIPE_PIECE_LAST)
+        {
+            result = used ? VIOGPU_PIPE_READ_OK : VIOGPU_PIPE_READ_FAILED;
+            break;
+        }
+    }
+
+    for (unsigned int i = used; i < capacity; ++i)
+    {
+        bytes[i] = 0;
+    }
+    return result;
+}
