+        ULONGLONG qpc;
+        const ULONGLONG nowUs = KeQueryInterruptTimePrecise(&qpc) / 10;
+        InterlockedExchange64(&m_scanLineTick, (LONG64)((nowUs << kScanPeriodBits) | periodUs));
