 static const LONGLONG kVsyncPeriod100ns = 166666LL; // 60 Hz
 static const LONGLONG kVsyncMaxLead100ns = 333333LL;
+// Keep the guest timestamp and host period in one atomic microsecond sample.
+static const UINT kScanPeriodBits = 16;
+static const ULONGLONG kScanPeriodMask = (1ULL << kScanPeriodBits) - 1;
 
