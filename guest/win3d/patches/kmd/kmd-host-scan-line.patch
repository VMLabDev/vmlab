+void VioGpuVidPN::GetScanLine(DXGKARG_GETSCANLINE *args)
+{
+    args->InVerticalBlank = FALSE;
+    args->ScanLine = 0;
+    if (args->VidPnTargetId != 0 || InterlockedCompareExchange(&m_hostVblank, 0, 0) == 0 ||
+        InterlockedCompareExchange(&m_shouldFlipStop, 0, 0) != 0)
+    {
+        return;
+    }
+
+    const ULONGLONG tick = (ULONGLONG)InterlockedCompareExchange64(&m_scanLineTick, 0, 0);
+    const ULONGLONG periodUs = tick & kScanPeriodMask;
+    const ULONG activeLines = m_CurrentModes[0].DispInfo.Height;
+    if (!periodUs || !activeLines)
+    {
+        return;
+    }
+
+    ULONGLONG qpc;
+    const ULONGLONG elapsedUs = KeQueryInterruptTimePrecise(&qpc) / 10 - (tick >> kScanPeriodBits);
+    if (elapsedUs >= 2 * periodUs)
+    {
+        return; // The tick stream has stopped or is too late to estimate phase.
+    }
+
+    // The virtual target exposes no blanking in its VidPN mode timings.
+    // Use a synthetic blanking interval like the host's generated EDID.
+    const UINT blankLines = 35;
+    const ULONGLONG phaseUs = elapsedUs % periodUs;
+    const UINT line = (UINT)(phaseUs * (activeLines + (ULONGLONG)blankLines) / periodUs);
+    if (line < blankLines)
+    {
+        args->InVerticalBlank = TRUE;
+    }
+    else
+    {
+        args->ScanLine = line - blankLines;
+    }
+}
